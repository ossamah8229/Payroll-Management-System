// Payroll Management System — Prisma schema
//
// Phase 1 (Role, Permission, RolePermission, User, ProjectSite, UserSiteAssignment, AuditLog) +
// Phase 2 master data (Bank, Employee, AdjustmentType, CompanySettings) — see
// docs/architecture/database-schema.md for the full design and docs/IMPLEMENTATION_PLAN.md for
// phase sequencing.
//
// ProjectSite deliberately has no relationship to Bank. Project Sites are physical client work
// locations only (Broom Services is a payroll-outsourcing company deputing staff to client sites —
// reference/PROJECT_SPEC.md — and site names like "ABL City Region Lahore" identify the *client*,
// not a bank Broom Services itself banks with). Employees own their own receiving bank account
// (Employee.bankId); Broom Services' own source account(s) for disbursement are a distinct concept
// not yet modeled anywhere in this schema — see docs/PROJECT_PROGRESS.md for the open item.
//
// Every other table in database-schema.md (PayrollCycle, PayrollEntry, Correction,
// BalanceAdjustment, Advance, BackupPackage, BackupPackageFile) is deferred to the phase that
// actually builds the module owning it, added via a new additive migration at that time — per
// Principle 8 (prefer additive schema evolution) and docs/IMPLEMENTATION_PLAN.md's phase
// breakdown. Nothing here contradicts database-schema.md; it is a strict subset, sequenced
// deliberately.
//
// Naming: model and field names match database-schema.md exactly (PascalCase models, camelCase
// fields) with no @map/@@map renaming to snake_case — that document never specifies a snake_case
// physical naming convention, and Prisma handles camelCase columns natively (it quotes
// identifiers in generated SQL), so introducing snake_case here would have been an unrequested
// deviation, not a requirement.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Closed, code-coupled set (docs/architecture/database-schema.md §1) — how an employee's gross
/// pay is computed (calcNet, Phase 3) differs structurally by pay type, so a new value would
/// require a code change regardless of schema representation.
enum PayType {
  DAILY_WAGE
  MONTHLY
}

/// Role → Permission RBAC (docs/architecture/authentication.md). A named bundle of permissions;
/// Master Admin and Payroll Staff today, extensible to future roles (e.g. an ESS "Employee" role)
/// as a data change, never a code change.
model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(40)
  name        String   @db.VarChar(80)
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  users           User[]
  rolePermissions RolePermission[]
}

/// An individual, checkable capability (e.g. `payroll:release`) — the atomic unit RBAC
/// middleware checks per route.
model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique @db.VarChar(80)
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  rolePermissions RolePermission[]
}

/// Join table — which permissions a role grants. Pure join semantics, so this is the one
/// relationship in the schema where cascade delete is appropriate (a row has no meaning
/// without both parents).
model RolePermission {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

/// A login account — Master Admin or Payroll Staff. Not to be confused with `Employee` (Phase 2),
/// who is paid but does not log in. Never hard-deleted — deactivated via `isActive`.
model User {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId           String    @db.Uuid
  name             String    @db.VarChar(120)
  email            String    @unique @db.VarChar(255)
  passwordHash     String    @db.VarChar(255)
  avatarStorageKey String?
  themeAccentColor String    @default("#1B4F72") @db.VarChar(7)
  isActive         Boolean   @default(true)
  lastLoginAt      DateTime? @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)

  role                   Role                      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  siteAssignments        UserSiteAssignment[]
  auditLogEntries        AuditLog[]
  companySettingsUpdates CompanySettings[]
  employeeTransfers      EmployeeTransferHistory[]

  @@index([roleId])
}

/// Reference list of banks an employee's own receiving account can be at — an extensible lookup
/// rather than a hardcoded enum, per Principle 8 (a new bank is a data row). Not related to
/// ProjectSite: Broom Services' own disbursement source account(s) are a distinct, not-yet-modeled
/// concept — see the file-level note above.
model Bank {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.VarChar(10)
  name      String   @db.VarChar(120)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  employees Employee[]
}

/// Project site master data — a pure client/location record (name, address; no banking
/// properties, no operational-unit properties of its own — see the file-level note above and
/// database-schema.md §8's 2026-07-03 revision note). `branchCode` removed 2026-07-03: a site's
/// operational sub-divisions are no longer a single flat field here — see `ProjectUnit` below.
/// Delete is blocked at the application layer while any Employee or ProjectUnit still references
/// it (checked before delete), with `Employee.siteId`/`ProjectUnit.siteId` as ON DELETE RESTRICT
/// database-level backstops.
model ProjectSite {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique @db.VarChar(160)
  /// Physical work-location address (2026-07-02 addition — see database-schema.md §8 revision note).
  address   String?  @db.VarChar(300)
  /// The term this site's own business uses for its operational sub-divisions (e.g. "Branch",
  /// "Department", "Section") — drives every place the UI names a ProjectUnit for this site; free
  /// text, not an enum, so a client's own vocabulary is never blocked by a missing picklist value
  /// (Principle 8). Added 2026-07-03 — see database-schema.md §8.
  unitLabel String   @default("Branch") @db.VarChar(40)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  userAssignments UserSiteAssignment[]
  employees       Employee[]
  units           ProjectUnit[]
  transfersFrom   EmployeeTransferHistory[] @relation("EmployeeTransferFromSite")
  transfersTo     EmployeeTransferHistory[] @relation("EmployeeTransferToSite")
}

/// The operational sub-division of a ProjectSite that an employee is actually deputed to — a
/// specific bank branch, mall department, retail section, etc. (docs/architecture/database-schema.md
/// §8a). Internally a single generic model regardless of what a given client calls it; the UI
/// always displays the owning site's own `unitLabel` in place of the literal word "Unit". Added
/// 2026-07-03 (Phase 2.5, Checkpoint 1), replacing the removed `ProjectSite.branchCode`. Delete is
/// blocked at the application layer while any Employee or PayrollEntryWorkLine (Phase 3) still
/// references it, with an ON DELETE RESTRICT database-level backstop on those future FKs.
model ProjectUnit {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId    String   @db.Uuid
  name      String   @db.VarChar(160)
  /// The unit's own operational code — the direct successor to the removed
  /// `ProjectSite.branchCode`, now correctly scoped to the specific branch/department it
  /// identifies rather than an entire client site.
  code      String?  @db.VarChar(20)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  site          ProjectSite               @relation(fields: [siteId], references: [id], onDelete: Restrict)
  employees     Employee[]
  transfersFrom EmployeeTransferHistory[] @relation("EmployeeTransferFromUnit")
  transfersTo   EmployeeTransferHistory[] @relation("EmployeeTransferToUnit")

  // `@@unique([id, siteId])` exists purely so downstream tables (Employee.unitId, added here in
  // Checkpoint 2, and PayrollEntryWorkLine in Phase 3) can declare a composite foreign key against
  // it — this is what makes "the unit must belong to the same site as the referencing row" a
  // database-level guarantee rather than an application-layer check alone
  // (database-schema.md §8a/§9/§12a).
  @@unique([siteId, name])
  @@unique([id, siteId])
  @@index([siteId])
}

/// Identity, employment, and bank details for a person on payroll — the Employee Registry
/// (docs/architecture/database-schema.md §9). Master record of *who* someone is, independent of
/// any single month's payroll figures (Principle 1: PayrollEntry owns the monthly figures).
/// Never hard-deleted — `dateOfLeaving` presence marks an employee as having left.
/// **`unitId` added 2026-07-03 (Phase 2.5, Checkpoint 2)**: an employee's *current default* Project
/// Unit — the Branch/Department/Section they're ordinarily rostered to (terminology per
/// `ProjectSite.unitLabel`). Paired with `siteId` via a composite foreign key
/// `(unitId, siteId) -> ProjectUnit(id, siteId)` so Postgres itself rejects any row where the
/// referenced unit doesn't belong to the referenced site — a database-level guarantee, not just an
/// application-layer check. Changing `siteId` and/or `unitId` on an existing Employee is a
/// *transfer* (see `EmployeeTransferHistory`, below), never an incidental field edit.
model Employee {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeCode          String?   @db.VarChar(30)
  cnic                  String?   @db.VarChar(15)
  name                  String    @db.VarChar(160)
  fatherName            String?   @db.VarChar(160)
  religion              String?   @db.VarChar(40)
  dateOfBirth           DateTime? @db.Date
  mobileNumber          String?   @db.VarChar(20)
  designation           String    @db.VarChar(80)
  siteId                String    @db.Uuid
  unitId                String    @db.Uuid
  dateOfJoining         DateTime? @db.Date
  dateOfLeaving         DateTime? @db.Date
  payType               PayType   @default(DAILY_WAGE)
  grossPay              Decimal   @db.Decimal(12, 2)
  bankId                String?   @db.Uuid
  branchCode            String?   @db.VarChar(20)
  accountNumber         String?   @db.VarChar(40)
  accountTitle          String?   @db.VarChar(160)
  defaultEobiAmount     Decimal   @default(400.00) @db.Decimal(10, 2)
  defaultEobiApplicable Boolean   @default(true)
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(6)

  site ProjectSite @relation(fields: [siteId], references: [id], onDelete: Restrict)
  unit ProjectUnit @relation(fields: [unitId, siteId], references: [id, siteId], onDelete: Restrict)
  bank Bank?       @relation(fields: [bankId], references: [id], onDelete: Restrict)

  transferHistory EmployeeTransferHistory[]

  // Partial unique indexes (WHERE ... IS NOT NULL) and the CNIC numeric-pattern check constraint
  // are not expressible via Prisma's schema DSL — both are added by raw SQL in the migration
  // (docs/architecture/database-schema.md §9).
  @@index([siteId])
  @@index([unitId])
  @@index([bankId])
}

/// Dedicated, append-only record of every Employee site/unit transfer
/// (docs/architecture/database-schema.md §8b) — added 2026-07-03 (Phase 2.5, Checkpoint 2),
/// alongside the finalized CNIC/Reactivate decision. Mirrors the existing `BalanceAdjustment`-vs-
/// `AuditLog` pattern: the generic `AuditLog` already captures a `employee.transferred` action for
/// the cross-entity audit trail, but a future Transfer History screen needs typed, directly
/// queryable columns rather than parsing `AuditLog.metadata` JSON. No UI consumes this table yet.
/// Immutable except by direct database intervention — no application code path updates or deletes
/// a row (same convention as `Correction`/`BackupPackage`, application-layer only, no DB trigger
/// unlike `AuditLog`'s stronger guarantee).
model EmployeeTransferHistory {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId          String   @db.Uuid
  fromSiteId          String   @db.Uuid
  toSiteId            String   @db.Uuid
  fromUnitId          String   @db.Uuid
  toUnitId            String   @db.Uuid
  /// The date the transfer actually took effect in the business — deliberately distinct from
  /// `createdAt`, since HR may enter a transfer into the system days or weeks after it happened.
  effectiveDate       DateTime @db.Date
  transferredByUserId String   @db.Uuid
  reason              String?
  remarks             String?
  createdAt           DateTime @default(now()) @db.Timestamptz(6)

  employee      Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  fromSite      ProjectSite @relation("EmployeeTransferFromSite", fields: [fromSiteId], references: [id], onDelete: Restrict)
  toSite        ProjectSite @relation("EmployeeTransferToSite", fields: [toSiteId], references: [id], onDelete: Restrict)
  fromUnit      ProjectUnit @relation("EmployeeTransferFromUnit", fields: [fromUnitId], references: [id], onDelete: Restrict)
  toUnit        ProjectUnit @relation("EmployeeTransferToUnit", fields: [toUnitId], references: [id], onDelete: Restrict)
  transferredBy User        @relation(fields: [transferredByUserId], references: [id], onDelete: Restrict)

  @@index([employeeId, effectiveDate(sort: Desc)])
  @@index([toUnitId, effectiveDate])
  @@index([fromSiteId])
  @@index([toSiteId])
  @@index([fromUnitId])
}

/// Which project sites a Payroll Staff user may access (docs/architecture/authentication.md).
/// Master Admin has implicit, unrestricted access and has no rows here.
model UserSiteAssignment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  siteId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  site ProjectSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([userId, siteId])
  @@index([userId])
  @@index([siteId])
}

/// Permanent, append-only record of every financial and administrative action (Principle 3).
/// Immutability is enforced at two layers: no application code path updates or deletes a row
/// (only `auditLog.record(...)`, an insert), and — for defense in depth — a database trigger
/// (see prisma/migrations/20260701164509_audit_log_immutability) rejects any UPDATE or DELETE
/// against this table outright.
model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurredAt  DateTime @default(now()) @db.Timestamptz(6)
  actorUserId String?  @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @db.VarChar(60)
  entityId    String?  @db.Uuid
  metadata    Json?
  ipAddress   String?  @db.Inet
  userAgent   String?

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([occurredAt(sort: Desc)])
}

/// The standardized classification list for Corrections (Phase 6) — an extensible lookup table
/// instead of a native enum, so a new type is a data row, never a migration (Principle 8).
model AdjustmentType {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.VarChar(40)
  label     String   @db.VarChar(120)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
}

/// Company name, address, and logo shown on payslips, bank sheets, and the app shell —
/// Master-Admin-only editable. Singleton enforced by a fixed, well-known primary key (see the
/// seed script), so the primary key itself guarantees at most one row can ever exist.
model CompanySettings {
  id                String   @id @db.Uuid
  companyName       String   @db.VarChar(200)
  registeredAddress String?  @db.VarChar(300)
  phone             String?  @db.VarChar(30)
  email             String?  @db.VarChar(255)
  logoStorageKey    String?
  updatedAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedById       String?  @db.Uuid

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}
