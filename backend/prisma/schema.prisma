// Payroll Management System — Prisma schema
//
// Phase 1 (Role, Permission, RolePermission, User, ProjectSite, UserSiteAssignment, AuditLog) +
// Phase 2 master data (Bank, Employee, AdjustmentType, CompanySettings) + Phase 2.5 (ProjectUnit,
// Employee.unitId, EmployeeTransferHistory) + Phase 3 Checkpoint 0 (PayrollCycle, PayrollEntry,
// PayrollEntryWorkLine) through Checkpoint 6 (all schema/migration + full application code) +
// Phase 3.5 Checkpoint 1 (TaskPriority, TaskStatus, TaskNotificationType, Task, TaskNotification —
// schema/migration only, no routes/services yet; permanently replaces the previously-planned Team
// Collaboration/Chat panel, docs/architecture/database/tasks.md) + Phase 4 Checkpoint 2 (FINANCE
// role — a seeded Role row, not a schema change — and PayrollUnitRelease,
// docs/architecture/database/release.md §12b; PayrollUnitReadiness and the Late Entry release path
// are deliberately deferred past this checkpoint) + Phase 4 Checkpoint 5 (Advances —
// `ScheduledPayrollPeriod`, `Advance`, `AdvanceScheduleChange`, docs/architecture/database/advances.md
// §15/§15a and payroll-cycle.md §10a; `PayrollEntry.advanceId`/`.eidAdvanceId` added here, closing
// the deferral noted below; `Advance.scheduledInstallmentAmount` is an additive field beyond §15's
// original column list — anticipated and named in docs/IMPLEMENTATION_PLAN.md's Phase 4 section as
// a "proposed schema addition," now implemented — needed so an INSTALLMENT-type advance's automatic
// per-cycle materialization has a staff-entered amount to apply, never a system-computed one,
// per the 2026-07-02 "Automatic Payroll Recovery" clarification. Cash Advances, Advance-only Bank
// Sheets, and Company Bank Account modeling are explicitly out of scope for this checkpoint — see
// docs/PROJECT_PROGRESS.md.) — see
// docs/architecture/database/ for the full design and docs/IMPLEMENTATION_PLAN.md for
// phase sequencing.
//
// ProjectSite deliberately has no relationship to Bank. Project Sites are physical client work
// locations only (Broom Services is a payroll-outsourcing company deputing staff to client sites —
// reference/PROJECT_SPEC.md — and site names like "ABL City Region Lahore" identify the *client*,
// not a bank Broom Services itself banks with). Employees own their own receiving bank account
// (Employee.bankId); Broom Services' own source account(s) for disbursement are a distinct concept
// not yet modeled anywhere in this schema — see docs/PROJECT_PROGRESS.md for the open item.
//
// Every other table in docs/architecture/database/ (Correction, BalanceAdjustment, BackupPackage,
// BackupPackageFile, PayrollUnitReadiness, CorrectionRequest,
// CorrectionPayment, BalanceAdjustmentSettlement) is deferred to the phase that actually builds
// the module owning it, added via a new additive migration at that time — per Principle 8 (prefer
// additive schema evolution) and docs/IMPLEMENTATION_PLAN.md's phase breakdown.
//
// PayrollEntry.advanceId/.eidAdvanceId are now included (Phase 4 Checkpoint 5) — both FKs to the
// new Advance table, closing the deferral noted in every prior revision of this file.
// PayrollEntry.remarks is the one column present here that is NOT in
// docs/architecture/database/payroll-entry.md §12 as originally frozen — also an
// explicit, approved Checkpoint 0 addition (see docs/architecture/database/payroll-entry.md §12's dated revision note).
// Nothing else here contradicts docs/architecture/database/; it is a strict subset, sequenced
// deliberately.
//
// Naming: model and field names match docs/architecture/database/ exactly (PascalCase models, camelCase
// fields) with no @map/@@map renaming to snake_case — that document never specifies a snake_case
// physical naming convention, and Prisma handles camelCase columns natively (it quotes
// identifiers in generated SQL), so introducing snake_case here would have been an unrequested
// deviation, not a requirement.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Closed, code-coupled set (docs/architecture/database/conventions-and-enums.md §1) — how an employee's gross
/// pay is computed (calcNet, Phase 3) differs structurally by pay type, so a new value would
/// require a code change regardless of schema representation.
enum PayType {
  DAILY_WAGE
  MONTHLY
}

/// Role → Permission RBAC (docs/architecture/authentication.md). A named bundle of permissions;
/// Master Admin, Payroll Staff, and Finance (added Phase 4 Checkpoint 2) today, extensible to
/// future roles (e.g. an ESS "Employee" role) as a data change, never a code change.
model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(40)
  name        String   @db.VarChar(80)
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  users           User[]
  rolePermissions RolePermission[]
}

/// An individual, checkable capability (e.g. `payroll:release`) — the atomic unit RBAC
/// middleware checks per route.
model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique @db.VarChar(80)
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  rolePermissions RolePermission[]
}

/// Join table — which permissions a role grants. Pure join semantics, so this is the one
/// relationship in the schema where cascade delete is appropriate (a row has no meaning
/// without both parents).
model RolePermission {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

/// A login account — Master Admin or Payroll Staff. Not to be confused with `Employee` (Phase 2),
/// who is paid but does not log in. Never hard-deleted — deactivated via `isActive`.
model User {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId           String    @db.Uuid
  name             String    @db.VarChar(120)
  email            String    @unique @db.VarChar(255)
  passwordHash     String    @db.VarChar(255)
  avatarStorageKey String?
  themeAccentColor String    @default("#1B4F72") @db.VarChar(7)
  isActive         Boolean   @default(true)
  lastLoginAt      DateTime? @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)

  role                   Role                      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  siteAssignments        UserSiteAssignment[]
  auditLogEntries        AuditLog[]
  companySettingsUpdates CompanySettings[]
  employeeTransfers      EmployeeTransferHistory[]
  payrollCyclesCreated   PayrollCycle[]            @relation("PayrollCycleCreatedBy")
  payrollCyclesReleased  PayrollCycle[]            @relation("PayrollCycleReleasedBy")
  payrollCyclesArchived  PayrollCycle[]            @relation("PayrollCycleArchivedBy")
  payrollEntriesReleased PayrollEntry[]            @relation("PayrollEntryReleasedBy")
  payrollUnitReleases    PayrollUnitRelease[]      @relation("PayrollUnitReleaseReleasedBy")
  tasksAssignedToMe      Task[]                    @relation("TaskAssignedTo")
  tasksAssignedByMe      Task[]                    @relation("TaskAssignedBy")
  taskNotifications      TaskNotification[]
  advanceScheduleChanges AdvanceScheduleChange[]

  @@index([roleId])
}

/// Reference list of banks an employee's own receiving account can be at — an extensible lookup
/// rather than a hardcoded enum, per Principle 8 (a new bank is a data row). Not related to
/// ProjectSite: Broom Services' own disbursement source account(s) are a distinct, not-yet-modeled
/// concept — see the file-level note above.
model Bank {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.VarChar(10)
  name      String   @db.VarChar(120)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  employees      Employee[]
  payrollEntries PayrollEntry[]
}

/// Project site master data — a pure client/location record (name, address; no banking
/// properties, no operational-unit properties of its own — see the file-level note above and
/// docs/architecture/database/sites-and-units.md §8's 2026-07-03 revision note). `branchCode` removed 2026-07-03: a site's
/// operational sub-divisions are no longer a single flat field here — see `ProjectUnit` below.
/// Delete is blocked at the application layer while any Employee or ProjectUnit still references
/// it (checked before delete), with `Employee.siteId`/`ProjectUnit.siteId` as ON DELETE RESTRICT
/// database-level backstops.
model ProjectSite {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique @db.VarChar(160)
  /// Physical work-location address (2026-07-02 addition — see docs/architecture/database/sites-and-units.md §8 revision note).
  address   String?  @db.VarChar(300)
  /// The term this site's own business uses for its operational sub-divisions (e.g. "Branch",
  /// "Department", "Section") — drives every place the UI names a ProjectUnit for this site; free
  /// text, not an enum, so a client's own vocabulary is never blocked by a missing picklist value
  /// (Principle 8). Added 2026-07-03 — see docs/architecture/database/sites-and-units.md §8.
  unitLabel String   @default("Branch") @db.VarChar(40)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  userAssignments UserSiteAssignment[]
  employees       Employee[]
  units           ProjectUnit[]
  transfersFrom   EmployeeTransferHistory[] @relation("EmployeeTransferFromSite")
  transfersTo     EmployeeTransferHistory[] @relation("EmployeeTransferToSite")
  payrollEntries  PayrollEntry[]
}

/// The operational sub-division of a ProjectSite that an employee is actually deputed to — a
/// specific bank branch, mall department, retail section, etc. (docs/architecture/database/sites-and-units.md
/// §8a). Internally a single generic model regardless of what a given client calls it; the UI
/// always displays the owning site's own `unitLabel` in place of the literal word "Unit". Added
/// 2026-07-03 (Phase 2.5, Checkpoint 1), replacing the removed `ProjectSite.branchCode`. Delete is
/// blocked at the application layer while any Employee or PayrollEntryWorkLine (Phase 3) still
/// references it, with an ON DELETE RESTRICT database-level backstop on those future FKs.
model ProjectUnit {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId    String   @db.Uuid
  name      String   @db.VarChar(160)
  /// The unit's own operational code — the direct successor to the removed
  /// `ProjectSite.branchCode`, now correctly scoped to the specific branch/department it
  /// identifies rather than an entire client site.
  code      String?  @db.VarChar(20)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  site          ProjectSite               @relation(fields: [siteId], references: [id], onDelete: Restrict)
  employees     Employee[]
  transfersFrom EmployeeTransferHistory[] @relation("EmployeeTransferFromUnit")
  transfersTo   EmployeeTransferHistory[] @relation("EmployeeTransferToUnit")
  workLines     PayrollEntryWorkLine[]
  unitReleases  PayrollUnitRelease[]

  // `@@unique([id, siteId])` exists purely so downstream tables (Employee.unitId, added in
  // Checkpoint 2, and PayrollEntryWorkLine.unitId, added in Phase 3 Checkpoint 0) can declare a
  // composite foreign key against it — this is what makes "the unit must belong to the same site
  // as the referencing row" a database-level guarantee rather than an application-layer check
  // alone (docs/architecture/database/sites-and-units.md §8a and docs/architecture/database/employee.md §9 and docs/architecture/database/payroll-entry.md §12a).
  @@unique([siteId, name])
  @@unique([id, siteId])
  @@index([siteId])
}

/// Identity, employment, and bank details for a person on payroll — the Employee Registry
/// (docs/architecture/database/employee.md §9). Master record of *who* someone is, independent of
/// any single month's payroll figures (Principle 1: PayrollEntry owns the monthly figures).
/// Never hard-deleted — `dateOfLeaving` presence marks an employee as having left.
/// **`unitId` added 2026-07-03 (Phase 2.5, Checkpoint 2)**: an employee's *current default* Project
/// Unit — the Branch/Department/Section they're ordinarily rostered to (terminology per
/// `ProjectSite.unitLabel`). Paired with `siteId` via a composite foreign key
/// `(unitId, siteId) -> ProjectUnit(id, siteId)` so Postgres itself rejects any row where the
/// referenced unit doesn't belong to the referenced site — a database-level guarantee, not just an
/// application-layer check. Changing `siteId` and/or `unitId` on an existing Employee is a
/// *transfer* (see `EmployeeTransferHistory`, below), never an incidental field edit.
model Employee {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeCode          String?   @db.VarChar(30)
  cnic                  String?   @db.VarChar(15)
  name                  String    @db.VarChar(160)
  fatherName            String?   @db.VarChar(160)
  religion              String?   @db.VarChar(40)
  dateOfBirth           DateTime? @db.Date
  mobileNumber          String?   @db.VarChar(20)
  designation           String    @db.VarChar(80)
  siteId                String    @db.Uuid
  unitId                String    @db.Uuid
  dateOfJoining         DateTime? @db.Date
  dateOfLeaving         DateTime? @db.Date
  payType               PayType   @default(DAILY_WAGE)
  grossPay              Decimal   @db.Decimal(12, 2)
  bankId                String?   @db.Uuid
  branchCode            String?   @db.VarChar(20)
  accountNumber         String?   @db.VarChar(40)
  /// **Added Phase 4 banking refinement (2026-07-11).** Optional; stored trimmed and uppercase.
  /// Replaces `accountTitle` (removed the same pass) — the account holder is now always the
  /// employee's own legal `name`, never a separately entered/stored string. VARCHAR(34) is the
  /// ISO 13616 international maximum (a Pakistani IBAN is 24 characters).
  iban                  String?   @db.VarChar(34)
  defaultEobiAmount     Decimal   @default(400.00) @db.Decimal(10, 2)
  defaultEobiApplicable Boolean   @default(true)
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(6)

  site ProjectSite @relation(fields: [siteId], references: [id], onDelete: Restrict)
  unit ProjectUnit @relation(fields: [unitId, siteId], references: [id, siteId], onDelete: Restrict)
  bank Bank?       @relation(fields: [bankId], references: [id], onDelete: Restrict)

  transferHistory EmployeeTransferHistory[]
  payrollEntries  PayrollEntry[]
  advances        Advance[]

  // Partial unique indexes (WHERE ... IS NOT NULL) and the CNIC numeric-pattern check constraint
  // are not expressible via Prisma's schema DSL — both are added by raw SQL in the migration
  // (docs/architecture/database/employee.md §9).
  @@index([siteId])
  @@index([unitId])
  @@index([bankId])
}

/// Dedicated, append-only record of every Employee site/unit transfer
/// (docs/architecture/database/employee.md §8b) — added 2026-07-03 (Phase 2.5, Checkpoint 2),
/// alongside the finalized CNIC/Reactivate decision. Mirrors the existing `BalanceAdjustment`-vs-
/// `AuditLog` pattern: the generic `AuditLog` already captures a `employee.transferred` action for
/// the cross-entity audit trail, but a future Transfer History screen needs typed, directly
/// queryable columns rather than parsing `AuditLog.metadata` JSON. No UI consumes this table yet.
/// Immutable except by direct database intervention — no application code path updates or deletes
/// a row (same convention as `Correction`/`BackupPackage`, application-layer only, no DB trigger
/// unlike `AuditLog`'s stronger guarantee).
model EmployeeTransferHistory {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId          String   @db.Uuid
  fromSiteId          String   @db.Uuid
  toSiteId            String   @db.Uuid
  fromUnitId          String   @db.Uuid
  toUnitId            String   @db.Uuid
  /// The date the transfer actually took effect in the business — deliberately distinct from
  /// `createdAt`, since HR may enter a transfer into the system days or weeks after it happened.
  effectiveDate       DateTime @db.Date
  transferredByUserId String   @db.Uuid
  reason              String?
  remarks             String?
  createdAt           DateTime @default(now()) @db.Timestamptz(6)

  employee      Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  fromSite      ProjectSite @relation("EmployeeTransferFromSite", fields: [fromSiteId], references: [id], onDelete: Restrict)
  toSite        ProjectSite @relation("EmployeeTransferToSite", fields: [toSiteId], references: [id], onDelete: Restrict)
  fromUnit      ProjectUnit @relation("EmployeeTransferFromUnit", fields: [fromUnitId], references: [id], onDelete: Restrict)
  toUnit        ProjectUnit @relation("EmployeeTransferToUnit", fields: [toUnitId], references: [id], onDelete: Restrict)
  transferredBy User        @relation(fields: [transferredByUserId], references: [id], onDelete: Restrict)

  @@index([employeeId, effectiveDate(sort: Desc)])
  @@index([toUnitId, effectiveDate])
  @@index([fromSiteId])
  @@index([toSiteId])
  @@index([fromUnitId])
}

/// Which project sites a Payroll Staff user may access (docs/architecture/authentication.md).
/// Master Admin has implicit, unrestricted access and has no rows here.
model UserSiteAssignment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  siteId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  site ProjectSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([userId, siteId])
  @@index([userId])
  @@index([siteId])
}

/// Permanent, append-only record of every financial and administrative action (Principle 3).
/// Immutability is enforced at two layers: no application code path updates or deletes a row
/// (only `auditLog.record(...)`, an insert), and — for defense in depth — a database trigger
/// (see prisma/migrations/20260701164509_audit_log_immutability) rejects any UPDATE or DELETE
/// against this table outright.
model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurredAt  DateTime @default(now()) @db.Timestamptz(6)
  actorUserId String?  @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @db.VarChar(60)
  entityId    String?  @db.Uuid
  metadata    Json?
  ipAddress   String?  @db.Inet
  userAgent   String?

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([occurredAt(sort: Desc)])
}

/// The standardized classification list for Corrections (Phase 6) — an extensible lookup table
/// instead of a native enum, so a new type is a data row, never a migration (Principle 8).
model AdjustmentType {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.VarChar(40)
  label     String   @db.VarChar(120)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
}

/// Company name, address, and logo shown on payslips, bank sheets, and the app shell —
/// Master-Admin-only editable. Singleton enforced by a fixed, well-known primary key (see the
/// seed script), so the primary key itself guarantees at most one row can ever exist.
model CompanySettings {
  id                String   @id @db.Uuid
  companyName       String   @db.VarChar(200)
  registeredAddress String?  @db.VarChar(300)
  phone             String?  @db.VarChar(30)
  email             String?  @db.VarChar(255)
  logoStorageKey    String?
  updatedAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedById       String?  @db.Uuid

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

/// Closed, code-coupled set (docs/architecture/database/conventions-and-enums.md §1) — the cycle lifecycle
/// state machine (docs/architecture/workflows/payroll-lifecycle.md §4) everything else keys off.
enum PayrollCycleStatus {
  DRAFT
  RELEASED
  ARCHIVED
}

/// One calendar month's payroll processing run and its lifecycle state
/// (docs/architecture/database/payroll-cycle.md §10). Phase 3 Checkpoint 0 adds only this schema — the
/// explicit "Start First Payroll Cycle" bootstrap action, "Finalize Cycle", and archiving are all
/// later-checkpoint/phase work (docs/IMPLEMENTATION_PLAN.md). `month BETWEEN 1 AND 12` and the
/// partial index `WHERE status = 'DRAFT'` (§10 — "the hot 'which cycle is Draft' lookup") are
/// Prisma-DSL-inexpressible and added by raw SQL in the migration, same pattern as `Employee`'s
/// CNIC check constraint (Phase 2).
model PayrollCycle {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  year          Int                @db.SmallInt
  month         Int                @db.SmallInt
  status        PayrollCycleStatus @default(DRAFT)
  sourceCycleId String?            @db.Uuid
  createdAt     DateTime           @default(now()) @db.Timestamptz(6)
  createdBy     String             @db.Uuid
  releasedAt    DateTime?          @db.Timestamptz(6)
  releasedBy    String?            @db.Uuid
  archivedAt    DateTime?          @db.Timestamptz(6)
  archivedBy    String?            @db.Uuid

  sourceCycle             PayrollCycle?            @relation("PayrollCycleSource", fields: [sourceCycleId], references: [id], onDelete: Restrict)
  derivedCycles           PayrollCycle[]           @relation("PayrollCycleSource")
  createdByUser           User                     @relation("PayrollCycleCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  releasedByUser          User?                    @relation("PayrollCycleReleasedBy", fields: [releasedBy], references: [id], onDelete: Restrict)
  archivedByUser          User?                    @relation("PayrollCycleArchivedBy", fields: [archivedBy], references: [id], onDelete: Restrict)
  entries                 PayrollEntry[]
  unitReleases            PayrollUnitRelease[]
  scheduledPayrollPeriods ScheduledPayrollPeriod[]

  @@unique([year, month])
}

/// **Added Phase 4 Checkpoint 5 (Advances).** The canonical way any module references a calendar
/// payroll period that does not yet have a materialized `PayrollCycle` row — see
/// docs/architecture/database/payroll-cycle.md §10a. Deliberately thin: no status, no lifecycle, no
/// entries — purely a calendar coordinate that resolves into a `PayrollCycle` once one is created
/// for it. Owned exclusively by Payroll Processing (this module); Advances only ever holds a
/// foreign key into this table, never creates/resolves/mutates/deletes a row directly — it calls
/// Payroll Processing's own exposed find-or-create function instead.
model ScheduledPayrollPeriod {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  year           Int       @db.SmallInt
  month          Int       @db.SmallInt
  /// Null until a `PayrollCycle` is actually created for this `(year, month)` — set exactly once,
  /// never again.
  payrollCycleId String?   @db.Uuid
  resolvedAt     DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  payrollCycle PayrollCycle? @relation(fields: [payrollCycleId], references: [id], onDelete: Restrict)

  originalForAdvances Advance[]               @relation("AdvanceOriginalPeriod")
  currentForAdvances  Advance[]               @relation("AdvanceCurrentPeriod")
  scheduleChangesFrom AdvanceScheduleChange[] @relation("AdvanceScheduleChangeFromPeriod")
  scheduleChangesTo   AdvanceScheduleChange[] @relation("AdvanceScheduleChangeToPeriod")

  // `month BETWEEN 1 AND 12` and the partial index `WHERE payrollCycleId IS NULL` are
  // Prisma-DSL-inexpressible and added by raw SQL in the migration.
  @@unique([year, month])
  @@index([payrollCycleId])
}

/// The single editable record of one employee's monthly payroll figures for one cycle — the
/// system's single source of truth (Principle 1, docs/architecture/database/payroll-entry.md §12).
/// Attendance (`days`/`otHours`/`otRate`/`cycleDays`) lives exclusively on the child
/// `PayrollEntryWorkLine` — every entry has at least one line, always (§12a).
///
/// **Deviates from §12 in two approved ways (Phase 3 Checkpoint 0 sign-off), one now closed:**
/// (1) `advanceId`/`eidAdvanceId` — deferred at Checkpoint 0, **now added by Phase 4 Checkpoint 5**,
/// both FKs to the new `Advance` table below.
/// (2) `remarks` IS included even though §12's original column list doesn't have it — an
/// approved addition, editable while the entry is editable, frozen into the permanent snapshot
/// once released, same as every other field (see this file's revision note and
/// `docs/architecture/database/payroll-entry.md` §12's own dated note).
///
/// The numeric `>= 0` check constraints, `released = true ⇒ releasedAt/releasedBy NOT NULL`, and
/// `lateReason IS NOT NULL ⇒ released = true` are Prisma-DSL-inexpressible and added by raw SQL
/// in the migration.
model PayrollEntry {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cycleId             String    @db.Uuid
  employeeId          String    @db.Uuid
  siteId              String    @db.Uuid
  designation         String    @db.VarChar(80)
  bankId              String?   @db.Uuid
  branchCode          String?   @db.VarChar(20)
  accountNumber       String?   @db.VarChar(40)
  /// **Added Phase 4 banking refinement (2026-07-11).** Copied from `Employee` at entry creation
  /// (or carried forward at new-cycle creation), then ordinarily Draft-editable — same "copied,
  /// not linked" convention as every other field in this group. Replaces `accountTitle` (removed
  /// the same pass); the account holder is always the entry's own `Employee.name` snapshot.
  iban                String?   @db.VarChar(34)
  grossPay            Decimal   @db.Decimal(12, 2)
  allowance           Decimal   @default(0) @db.Decimal(12, 2)
  leaveDays           Decimal   @default(0) @db.Decimal(5, 2)
  leaveRate           Decimal?  @db.Decimal(10, 2)
  eobiAmount          Decimal   @default(400.00) @db.Decimal(10, 2)
  eobiApplicable      Boolean   @default(true)
  advanceDeduction    Decimal   @default(0) @db.Decimal(12, 2)
  /// **Added Phase 4 Checkpoint 5.** The specific `LOAN`-type Advance this cycle's
  /// `advanceDeduction` reduces — recorded at the moment the deduction is entered/materialized,
  /// never re-inferred later from "whichever advance is currently active" (docs/architecture/
  /// database/advances.md §15). Frozen once the entry releases, exactly like every other field here.
  advanceId           String?   @db.Uuid
  eidAdvanceDeduction Decimal   @default(0) @db.Decimal(12, 2)
  /// **Added Phase 4 Checkpoint 5.** Same as `advanceId`, for the `EID_ADVANCE`-type Advance this
  /// cycle's `eidAdvanceDeduction` reduces.
  eidAdvanceId        String?   @db.Uuid
  fine                Decimal   @default(0) @db.Decimal(12, 2)
  hold                Boolean   @default(false)
  released            Boolean   @default(false)
  releasedAt          DateTime? @db.Timestamptz(6)
  releasedBy          String?   @db.Uuid
  lateReason          String?
  /// Approved Phase 3 Checkpoint 0 addition — not in docs/architecture/database/payroll-entry.md §12 as originally
  /// frozen. Editable while the entry is editable; frozen into the permanent snapshot once
  /// released, exactly like every other Draft-editable field.
  remarks             String?
  /// User-controlled drag-to-reorder position within the cycle. Assigned by the application at
  /// entry-creation time (Checkpoint 1), not a database sequence.
  sortOrder           Int       @default(0)
  /// Optimistic-locking token — incremented on every update (Checkpoint 1).
  version             Int       @default(1)
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(6)

  cycle                  PayrollCycle            @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  employee               Employee                @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  site                   ProjectSite             @relation(fields: [siteId], references: [id], onDelete: Restrict)
  bank                   Bank?                   @relation(fields: [bankId], references: [id], onDelete: Restrict)
  releasedByUser         User?                   @relation("PayrollEntryReleasedBy", fields: [releasedBy], references: [id], onDelete: Restrict)
  workLines              PayrollEntryWorkLine[]
  advance                Advance?                @relation("PayrollEntryAdvance", fields: [advanceId], references: [id], onDelete: Restrict)
  eidAdvance             Advance?                @relation("PayrollEntryEidAdvance", fields: [eidAdvanceId], references: [id], onDelete: Restrict)
  advanceScheduleChanges AdvanceScheduleChange[]

  @@unique([cycleId, employeeId])
  @@index([cycleId])
  @@index([employeeId])
  @@index([cycleId, hold, released])
  @@index([cycleId, siteId])
  @@index([bankId])
  @@index([advanceId])
  @@index([eidAdvanceId])
}

/// One employee's attendance at one specific `ProjectUnit`, for one `PayrollEntry`
/// (docs/architecture/database/payroll-entry.md §12a) — always at least one per entry, never zero,
/// never optional (enforced transactionally at write time in Checkpoint 1, not by this schema
/// alone). `siteId` here is a denormalized copy of the parent `PayrollEntry.siteId` at
/// line-creation time, present purely so `unitId` can be composite-FK'd against it — it is not
/// independently FK'd to `ProjectSite` itself (the parent `PayrollEntry.siteId` already is).
/// The business rule that a line's unit must belong to the same site as its parent entry is a
/// database-level guarantee via this composite FK, exactly the same mechanism already proven by
/// `Employee.unitId` (Phase 2.5). The `days >= 0`, `otHours >= 0`, and
/// `cycleDays BETWEEN 1 AND 31` check constraints are Prisma-DSL-inexpressible and added by raw
/// SQL in the migration.
model PayrollEntryWorkLine {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payrollEntryId String   @db.Uuid
  siteId         String   @db.Uuid
  unitId         String   @db.Uuid
  days           Decimal  @default(0) @db.Decimal(5, 2)
  otHours        Decimal  @default(0) @db.Decimal(6, 2)
  otRate         Decimal? @db.Decimal(10, 2)
  cycleDays      Int      @default(30) @db.SmallInt
  /// Display order within the entry; the line with the lowest sortOrder is the entry's "primary"
  /// line for leave-rate-basis purposes (§12).
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  payrollEntry PayrollEntry @relation(fields: [payrollEntryId], references: [id], onDelete: Cascade)
  unit         ProjectUnit  @relation(fields: [unitId, siteId], references: [id, siteId], onDelete: Restrict)

  @@unique([payrollEntryId, unitId])
  @@index([payrollEntryId])
  @@index([unitId])
}

/// The release event for one Project Unit, for one cycle (docs/architecture/database/release.md
/// §12b, Phase 4 Checkpoint 2) — the source of truth `PayrollEntry.released` is derived from.
/// Immutable, append-only: inserted once per `(cycleId, unitId)`, never updated or deleted — there
/// is no "un-release" action (Principle 9). Inserting this row must, in the same transaction,
/// sweep every non-held `PayrollEntry` at this Unit's own Site whose work lines touch `unitId`
/// and, for each one whose every distinct touched Unit now has a release row, flip
/// `PayrollEntry.released`/`releasedAt`/`releasedBy` and write its own `payroll_entry.released`
/// audit entry — see `payroll-release.service.ts`. `PayrollUnitReadiness` ("Ready for Release")
/// and the Late Entry one-off release path are both explicitly deferred past this checkpoint (not
/// built here) — see docs/PROJECT_PROGRESS.md's Phase 4 Checkpoint 2 entry for the scope decision.
model PayrollUnitRelease {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cycleId      String   @db.Uuid
  unitId       String   @db.Uuid
  releasedAt   DateTime @default(now()) @db.Timestamptz(6)
  /// Must hold `payroll:release` for this Unit's Site (Finance or Master User) — enforced at the
  /// application layer, docs/architecture/authentication.md.
  releasedById String   @db.Uuid

  cycle      PayrollCycle @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  unit       ProjectUnit  @relation(fields: [unitId], references: [id], onDelete: Restrict)
  releasedBy User         @relation("PayrollUnitReleaseReleasedBy", fields: [releasedById], references: [id], onDelete: Restrict)

  @@unique([cycleId, unitId])
  @@index([cycleId])
  @@index([unitId])
}

/// Closed, code-coupled set (docs/architecture/database/conventions-and-enums.md §1) — a lightweight,
/// deliberately non-extensible set for the Tasks Workspace (docs/architecture/database/tasks.md §27,
/// Phase 3.5). A new priority level would be a real UI/behavior decision, not a data row.
enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

/// Closed, code-coupled set — the Task lifecycle (docs/architecture/database/tasks.md §27).
/// Deliberately no IN_PROGRESS value (frozen decision, 2026-07-10): evaluated and rejected as
/// unnecessary granularity for a lightweight delegation list.
enum TaskStatus {
  TO_DO
  COMPLETED
  CANCELLED
}

/// Closed, code-coupled set — the only three notification events this system ever persists
/// (docs/architecture/database/tasks.md §27a). Due-today/overdue are deliberately NOT represented
/// here; they are computed live from Task.dueDate/Task.status, never stored.
enum TaskNotificationType {
  ASSIGNED
  REASSIGNED
  COMPLETED
}

/// A single unit of internally-delegated work (docs/architecture/database/tasks.md §27, Phase 3.5)
/// — Master User assigns something to exactly one other user and tracks whether it gets done. Not a
/// project-management tool: no subtasks, no dependencies, no recurrence, no comment thread — those
/// are permanently out of scope, not deferred (see the file-level revision note in
/// docs/architecture/database/tasks.md). Permanently replaces the previously-planned Team
/// Collaboration/Chat panel (reference/PROJECT_SPEC.md, reference/payroll_prototype.html — both
/// frozen, unedited historical reference; this schema is the current authority).
/// Ownership-based visibility, not site- or role-based: a task is visible only to Master User and
/// the one user in `assignedToUserId` — see docs/architecture/authentication.md's "Tasks:
/// ownership-based visibility" section. Deliberately carries no optimistic-locking `version` column
/// — at most two people ever touch one row, writing disjoint fields (Master User owns every
/// field-level mutation; the assignee's only possible write is the completion flip), unlike
/// PayrollEntry's genuine multi-editor exposure (docs/architecture/database/schema-invariants.md
/// §22).
model Task {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title             String       @db.VarChar(200)
  description       String?
  assignedToUserId  String       @db.Uuid
  assignedByUserId  String       @db.Uuid
  /// Set on creation; updated whenever `assignedToUserId` changes (a reassignment) — drives the
  /// "Recently Assigned" sort and the `task.reassigned` notification's timing, independent of
  /// `createdAt`.
  assignedAt        DateTime     @default(now()) @db.Timestamptz(6)
  priority          TaskPriority @default(MEDIUM)
  status            TaskStatus   @default(TO_DO)
  dueDate           DateTime?    @db.Date
  /// Free text, not a native enum, by deliberate choice — mirrors AuditLog.entityType's own
  /// convention, since the set of "modules a task might be about" grows every phase and a native
  /// enum would force a migration each time one does.
  module            String?      @db.VarChar(60)
  /// Polymorphic reference, reusing AuditLog's own entityType/entityId shape rather than inventing
  /// a second pattern for the same idea.
  relatedEntityType String?      @db.VarChar(60)
  /// No FK constraint (same reasoning as AuditLog.entityId — the referenced table varies).
  relatedEntityId   String?      @db.Uuid
  createdAt         DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(6)
  /// Set when `status` becomes COMPLETED; cleared on reopen.
  completedAt       DateTime?    @db.Timestamptz(6)

  assignedTo    User               @relation("TaskAssignedTo", fields: [assignedToUserId], references: [id], onDelete: Restrict)
  assignedBy    User               @relation("TaskAssignedBy", fields: [assignedByUserId], references: [id], onDelete: Restrict)
  notifications TaskNotification[]

  @@index([assignedToUserId])
  @@index([dueDate])
  @@index([priority])
  @@index([assignedAt])
  @@index([status])
}

/// The persisted half of the in-app Task notification model (docs/architecture/database/tasks.md
/// §27a, Phase 3.5) — one row per discrete event a user should be told about. Due-today/overdue are
/// NOT rows here; they are computed live from Task.dueDate/Task.status at read time. No
/// WebSockets/SSE — delivered via ordinary client polling (docs/architecture/authentication.md's
/// Postgres-over-Redis reasoning applies identically here). Deliberately scoped to Tasks only, not a
/// general-purpose notification system — a second real consumer would be the trigger to generalize
/// this, not anticipated demand.
model TaskNotification {
  id        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String               @db.Uuid
  taskId    String               @db.Uuid
  type      TaskNotificationType
  createdAt DateTime             @default(now()) @db.Timestamptz(6)
  /// Null = unread; the badge count is COUNT(*) WHERE userId = :current AND readAt IS NULL.
  readAt    DateTime?            @db.Timestamptz(6)

  /// Both FKs CASCADE — unlike AuditLog (SET NULL on actor deletion) or Task itself (RESTRICT), a
  /// notification has no standalone historical value once its User or Task is gone; it is ephemeral
  /// UI state, not a record of what happened. A deliberate, narrow exception to this schema's
  /// general RESTRICT-by-default convention, not an inconsistency.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

/// Closed, code-coupled set (docs/architecture/database/conventions-and-enums.md §1) — Phase 4
/// Checkpoint 5 (Advances).
enum AdvanceType {
  LOAN
  EID_ADVANCE
}

/// Closed, code-coupled set — informational only per the original spec ("no auto-calculation of
/// installment size"); does not drive any system-computed behavior on its own.
enum AdvanceRepaymentType {
  FULL_DEDUCTION
  INSTALLMENT
}

/// Closed, code-coupled set — an Advance's lifecycle. `PAID_OFF` is reached only when
/// `outstandingBalance` decrements to zero; never set directly by a user action.
enum AdvanceStatus {
  ACTIVE
  PAID_OFF
}

/// A record of a loan or Eid advance given to an employee, and its remaining balance (Phase 4
/// Checkpoint 5, docs/architecture/database/advances.md §15). At most one `ACTIVE` Advance may
/// exist per employee per type at any time (approved, frozen architecture decision) — enforced by
/// a partial unique index (raw SQL in the migration; Prisma's schema DSL cannot express a
/// conditional unique index) and re-checked at the application layer before every create.
///
/// **`scheduledInstallmentAmount`** is an additive field beyond docs/architecture/database/
/// advances.md §15's original column list — anticipated by name in docs/IMPLEMENTATION_PLAN.md's
/// Phase 4 section as a "proposed schema addition... not yet implemented," now implemented here.
/// It is what lets an `INSTALLMENT`-type Advance's deduction materialize automatically at new-cycle
/// creation without the system ever computing the amount itself (Principle: "no value is ever
/// computed by the system, only repeated forward until staff changes it" — the 2026-07-02
/// "Automatic Payroll Recovery" clarification). Null means no standing schedule yet (or a one-off
/// `FULL_DEDUCTION` advance, which never uses this field at all).
///
/// **`paidOffAt`** is likewise additive beyond §15's original column list — required permanent
/// history ("paid-off date, when applicable") this checkpoint's own requirements call for; set once,
/// the instant `status` transitions to `PAID_OFF`, never cleared or changed again.
///
/// Never hard-deletable — no delete path exists at the application layer, matching this schema's
/// established convention for every other permanent financial/master record (Employee, Bank's
/// protected Cash row). "Amount recovered" (`totalAmount - outstandingBalance`) is calculated on
/// read, never stored, per Principle 5/6 — the same convention `netSalary` already follows.
model Advance {
  id                         String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId                 String               @db.Uuid
  type                       AdvanceType
  totalAmount                Decimal              @db.Decimal(12, 2)
  /// Decremented as matching `PayrollEntry` deductions materialize; reaching zero flips `status`
  /// to `PAID_OFF`. The only two paths that ever change this: the automatic cycle-bootstrap
  /// materialization below, and (once Phase 6 exists) an approved Correction reconciliation.
  outstandingBalance         Decimal              @db.Decimal(12, 2)
  dateGiven                  DateTime             @db.Date
  repaymentType              AdvanceRepaymentType
  /// See the model-level doc comment above.
  scheduledInstallmentAmount Decimal?             @db.Decimal(12, 2)
  notes                      String?
  status                     AdvanceStatus        @default(ACTIVE)
  originalScheduledPeriodId  String?              @db.Uuid
  currentScheduledPeriodId   String?              @db.Uuid
  paidOffAt                  DateTime?            @db.Timestamptz(6)
  createdAt                  DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime             @updatedAt @db.Timestamptz(6)

  employee                   Employee                @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  originalScheduledPeriod    ScheduledPayrollPeriod? @relation("AdvanceOriginalPeriod", fields: [originalScheduledPeriodId], references: [id], onDelete: Restrict)
  currentScheduledPeriod     ScheduledPayrollPeriod? @relation("AdvanceCurrentPeriod", fields: [currentScheduledPeriodId], references: [id], onDelete: Restrict)
  scheduleChanges            AdvanceScheduleChange[]
  payrollEntriesAsAdvance    PayrollEntry[]          @relation("PayrollEntryAdvance")
  payrollEntriesAsEidAdvance PayrollEntry[]          @relation("PayrollEntryEidAdvance")

  // Partial unique index `(employeeId, type) WHERE status = 'ACTIVE'` and the check constraints
  // (`totalAmount > 0`, `outstandingBalance >= 0 AND outstandingBalance <= totalAmount`,
  // `status = 'PAID_OFF' ⇒ currentScheduledPeriodId IS NULL`) are Prisma-DSL-inexpressible and
  // added by raw SQL in the migration.
  @@index([employeeId])
  @@index([currentScheduledPeriodId])
}

/// The append-only history of every change made to an Advance's scheduled deduction period (Phase 4
/// Checkpoint 5, docs/architecture/database/advances.md §15a). Named for what it records — changes
/// to the schedule — not the schedule itself, which always lives on
/// `Advance.currentScheduledPeriodId`. No updates, no deletes, only inserts — same convention as
/// `EmployeeTransferHistory`/`PayrollUnitRelease`.
model AdvanceScheduleChange {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  advanceId      String   @db.Uuid
  /// The entry this change removed the materialized deduction from — deferral only ever operates
  /// on a deduction that has already materialized into a real, still-Draft `PayrollEntry`; there is
  /// no "reschedule before it ever lands" action (see the architecture review's reasoning).
  payrollEntryId String   @db.Uuid
  fromPeriodId   String   @db.Uuid
  toPeriodId     String   @db.Uuid
  reason         String
  changedById    String   @db.Uuid
  changedAt      DateTime @default(now()) @db.Timestamptz(6)

  advance      Advance                @relation(fields: [advanceId], references: [id], onDelete: Restrict)
  payrollEntry PayrollEntry           @relation(fields: [payrollEntryId], references: [id], onDelete: Restrict)
  fromPeriod   ScheduledPayrollPeriod @relation("AdvanceScheduleChangeFromPeriod", fields: [fromPeriodId], references: [id], onDelete: Restrict)
  toPeriod     ScheduledPayrollPeriod @relation("AdvanceScheduleChangeToPeriod", fields: [toPeriodId], references: [id], onDelete: Restrict)
  changedBy    User                   @relation(fields: [changedById], references: [id], onDelete: Restrict)

  // `length(trim(reason)) > 0` is Prisma-DSL-inexpressible and added by raw SQL in the migration.
  // The "target must be strictly future" rule (BR-ADV-006) has no database-level backstop —
  // enforced at the application layer only, per the same reasoning already documented for this
  // table in docs/architecture/database/advances.md §15a.
  @@index([advanceId, changedAt(sort: Desc)])
  @@index([payrollEntryId])
}
