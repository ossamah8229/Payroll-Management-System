// Payroll Management System — Prisma schema
//
// Phase 1 (Role, Permission, RolePermission, User, ProjectSite, UserSiteAssignment, AuditLog) +
// Phase 2 master data (Bank, Employee, AdjustmentType, CompanySettings) + Phase 2.5 (ProjectUnit,
// Employee.unitId, EmployeeTransferHistory) + Phase 3 Checkpoint 0 (PayrollCycle, PayrollEntry,
// PayrollEntryWorkLine) through Checkpoint 6 (all schema/migration + full application code) +
// Phase 3.5 Checkpoint 1 (TaskPriority, TaskStatus, TaskNotificationType, Task, TaskNotification —
// schema/migration only, no routes/services yet; permanently replaces the previously-planned Team
// Collaboration/Chat panel, docs/architecture/database/tasks.md) + Phase 4 Checkpoint 2 (FINANCE
// role — a seeded Role row, not a schema change — and PayrollUnitRelease,
// docs/architecture/database/release.md §12b; PayrollUnitReadiness and the Late Entry release path
// are deliberately deferred past this checkpoint) + Phase 4 Checkpoint 5 (Advances —
// `ScheduledPayrollPeriod`, `Advance`, `AdvanceScheduleChange`, docs/architecture/database/advances.md
// §15/§15a and payroll-cycle.md §10a; `PayrollEntry.advanceId`/`.eidAdvanceId` added here, closing
// the deferral noted below; `Advance.scheduledInstallmentAmount` is an additive field beyond §15's
// original column list — anticipated and named in docs/IMPLEMENTATION_PLAN.md's Phase 4 section as
// a "proposed schema addition," now implemented — needed so an INSTALLMENT-type advance's automatic
// per-cycle materialization has a staff-entered amount to apply, never a system-computed one,
// per the 2026-07-02 "Automatic Payroll Recovery" clarification. Cash Advances, Advance-only Bank
// Sheets, and Company Bank Account modeling are explicitly out of scope for this checkpoint — see
// docs/PROJECT_PROGRESS.md.) — see
// docs/architecture/database/ for the full design and docs/IMPLEMENTATION_PLAN.md for
// phase sequencing.
//
// ProjectSite deliberately has no relationship to Bank. Project Sites are physical client work
// locations only (Broom Services is a payroll-outsourcing company deputing staff to client sites —
// reference/PROJECT_SPEC.md — and site names like "ABL City Region Lahore" identify the *client*,
// not a bank Broom Services itself banks with). Employees own their own receiving bank account
// (Employee.bankId); Broom Services' own source account(s) for disbursement are a distinct concept
// not yet modeled anywhere in this schema — see docs/PROJECT_PROGRESS.md for the open item.
//
// Phase 5 Checkpoint 2 (Backup Packages) adds `BackupPackage`/`BackupPackageFile` — the reusable
// backup-generation domain (docs/architecture/database/payroll-cycle.md §17-18, amended from the
// original frozen sketch per the 2026-07-14 architecture review: adds `status`/`generatedBy`/
// `failureReason` to `BackupPackage` and `filename`/`contentType`/`checksum`/`sortOrder` to
// `BackupPackageFile`, none of which the original sketch included). Generation is manually
// triggered only this checkpoint — no automatic month-end generation, no cycle archiving, both
// still later Phase 5 checkpoints.
//
// Every other table in docs/architecture/database/ (Correction, BalanceAdjustment,
// PayrollUnitReadiness, CorrectionRequest, CorrectionPayment, BalanceAdjustmentSettlement) is
// deferred to the phase that actually builds the module owning it, added via a new additive
// migration at that time — per Principle 8 (prefer additive schema evolution) and
// docs/IMPLEMENTATION_PLAN.md's phase breakdown.
//
// PayrollEntry.advanceId/.eidAdvanceId are now included (Phase 4 Checkpoint 5) — both FKs to the
// new Advance table, closing the deferral noted in every prior revision of this file.
// PayrollEntry.remarks is the one column present here that is NOT in
// docs/architecture/database/payroll-entry.md §12 as originally frozen — also an
// explicit, approved Checkpoint 0 addition (see docs/architecture/database/payroll-entry.md §12's dated revision note).
// Nothing else here contradicts docs/architecture/database/; it is a strict subset, sequenced
// deliberately.
//
// Naming: model and field names match docs/architecture/database/ exactly (PascalCase models, camelCase
// fields) with no @map/@@map renaming to snake_case — that document never specifies a snake_case
// physical naming convention, and Prisma handles camelCase columns natively (it quotes
// identifiers in generated SQL), so introducing snake_case here would have been an unrequested
// deviation, not a requirement.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Closed, code-coupled set (docs/architecture/database/conventions-and-enums.md §1) — how an employee's gross
/// pay is computed (calcNet, Phase 3) differs structurally by pay type, so a new value would
/// require a code change regardless of schema representation.
enum PayType {
  DAILY_WAGE
  MONTHLY
}

/// Role → Permission RBAC (docs/architecture/authentication.md). A named bundle of permissions —
/// Master Admin, Payroll Staff, and Finance are the three seeded (`isSystemRole = true`) roles;
/// Administration & Security Management Phase 1 adds administrator-created custom roles as
/// ordinary data rows (`isSystemRole = false`), never a code change. `Role.name` is an
/// administrator-editable display label with no authorization meaning of its own — `Role.id` (via
/// `User.roleId`) is the one true, immutable identity; `Role.code` is a stable, system-generated
/// internal identifier for a custom role (derived from `name` at creation time, never changed by a
/// rename) that authorization code must never depend on either — the one exception is the small,
/// explicitly-documented set of legacy `roleCode === ROLE_CODES.MASTER_ADMIN` bypass checks
/// pre-dating this phase (docs/architecture/authentication.md's "Post-Phase-5 Stabilization
/// Checkpoint 4B" section), deliberately left in place rather than migrated in this phase.
model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(40)
  name        String   @db.VarChar(80)
  description String?
  /// Gates *new* assignment only (create-user, reassign-role) — matches this schema's own
  /// existing `Bank.isActive`/`ProjectSite.isActive` convention of "blocks new links, never
  /// severs an existing one" — **except** that here it also strips a currently-assigned user's
  /// effective access (`auth.service.ts`'s `loadSessionUser` treats `!role.isActive` exactly like
  /// `!user.isActive`), a deliberate, documented deviation from that convention: an inactive Role
  /// must be able to immediately end a security-sensitive grant, not just stop new sign-ups to it.
  isActive Boolean @default(true)
  /// True only for the three seeded roles (Master Admin, Payroll Staff, Finance) — the sole
  /// authoritative signal for "this role cannot be deleted, and its name cannot be reused by (or
  /// renamed away from being recognized as) a protected role." Never inferred from `name` or
  /// `code` — an administrator renaming a custom role to "Master Admin" gains no special status,
  /// and this column is never set outside `prisma/seed.ts`.
  isSystemRole Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  users           User[]
  rolePermissions RolePermission[]
}

/// An individual, checkable capability (e.g. `payroll:release`) — the atomic unit RBAC
/// middleware checks per route.
model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique @db.VarChar(80)
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  rolePermissions RolePermission[]
}

/// Join table — which permissions a role grants. Pure join semantics, so this is the one
/// relationship in the schema where cascade delete is appropriate (a row has no meaning
/// without both parents).
model RolePermission {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

/// A login account — Master Admin or Payroll Staff. Not to be confused with `Employee` (Phase 2),
/// who is paid but does not log in. Never hard-deleted — deactivated via `isActive`.
model User {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId           String    @db.Uuid
  name             String    @db.VarChar(120)
  email            String    @unique @db.VarChar(255)
  passwordHash     String    @db.VarChar(255)
  avatarStorageKey String?
  themeAccentColor String    @default("#1B4F72") @db.VarChar(7)
  isActive         Boolean   @default(true)
  lastLoginAt      DateTime? @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)

  role                        Role                      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  siteAssignments             UserSiteAssignment[]
  projectSitesCreated         ProjectSite[]             @relation("ProjectSiteCreatedBy")
  auditLogEntries             AuditLog[]
  companySettingsUpdates      CompanySettings[]
  employeeTransfers           EmployeeTransferHistory[]
  payrollCyclesCreated        PayrollCycle[]            @relation("PayrollCycleCreatedBy")
  payrollCyclesReleased       PayrollCycle[]            @relation("PayrollCycleReleasedBy")
  payrollCyclesArchived       PayrollCycle[]            @relation("PayrollCycleArchivedBy")
  payrollEntriesReleased      PayrollEntry[]            @relation("PayrollEntryReleasedBy")
  payrollUnitReleases         PayrollUnitRelease[]      @relation("PayrollUnitReleaseReleasedBy")
  tasksAssignedToMe           Task[]                    @relation("TaskAssignedTo")
  tasksAssignedByMe           Task[]                    @relation("TaskAssignedBy")
  taskNotifications           TaskNotification[]
  advanceScheduleChanges      AdvanceScheduleChange[]
  backupPackagesGenerated     BackupPackage[]           @relation("BackupPackageGeneratedBy")
  /// Phase 6 Checkpoint 1 — schema/domain foundation only, see `Correction`/`CorrectionRequest`/
  /// `CorrectionPayment`'s own comments.
  correctionRequestsRequested CorrectionRequest[]       @relation("CorrectionRequestRequestedBy")
  correctionRequestsReviewed  CorrectionRequest[]       @relation("CorrectionRequestReviewedBy")
  correctionsApproved         Correction[]              @relation("CorrectionApprovedBy")
  correctionPaymentsPaid      CorrectionPayment[]       @relation("CorrectionPaymentPaidBy")

  @@index([roleId])
}

/// Reference list of banks an employee's own receiving account can be at — an extensible lookup
/// rather than a hardcoded enum, per Principle 8 (a new bank is a data row). Not related to
/// ProjectSite: Broom Services' own disbursement source account(s) are a distinct, not-yet-modeled
/// concept — see the file-level note above.
model Bank {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.VarChar(10)
  name      String   @db.VarChar(120)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  employees          Employee[]
  payrollEntries     PayrollEntry[]
  /// Phase 6 Checkpoint 1 — schema/domain foundation only.
  correctionPayments CorrectionPayment[]
}

/// Project site master data — a pure client/location record (name, address; no banking
/// properties, no operational-unit properties of its own — see the file-level note above and
/// docs/architecture/database/sites-and-units.md §8's 2026-07-03 revision note). `branchCode` removed 2026-07-03: a site's
/// operational sub-divisions are no longer a single flat field here — see `ProjectUnit` below.
/// Delete is blocked at the application layer while any Employee or ProjectUnit still references
/// it (checked before delete), with `Employee.siteId`/`ProjectUnit.siteId` as ON DELETE RESTRICT
/// database-level backstops.
model ProjectSite {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique @db.VarChar(160)
  /// Physical work-location address (2026-07-02 addition — see docs/architecture/database/sites-and-units.md §8 revision note).
  address   String?  @db.VarChar(300)
  /// The term this site's own business uses for its operational sub-divisions (e.g. "Branch",
  /// "Department", "Section") — drives every place the UI names a ProjectUnit for this site; free
  /// text, not an enum, so a client's own vocabulary is never blocked by a missing picklist value
  /// (Principle 8). Added 2026-07-03 — see docs/architecture/database/sites-and-units.md §8.
  unitLabel String   @default("Branch") @db.VarChar(40)
  isActive  Boolean  @default(true)
  /// Who created this site — nullable because every site created before this column existed has
  /// no recoverable creator identity (see docs/architecture/rbac-creator-access.md's existing-data
  /// finding; `AuditLog` entries for `project-site.created` are the only trace for those rows, and
  /// are not backfilled into this column automatically). Populated going forward by
  /// `createProjectSite` for audit provenance only — access control itself is driven by
  /// `UserSiteAssignment`, never by this column.
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  createdBy       User?                     @relation("ProjectSiteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  userAssignments UserSiteAssignment[]
  employees       Employee[]
  units           ProjectUnit[]
  transfersFrom   EmployeeTransferHistory[] @relation("EmployeeTransferFromSite")
  transfersTo     EmployeeTransferHistory[] @relation("EmployeeTransferToSite")
  payrollEntries  PayrollEntry[]
}

/// The operational sub-division of a ProjectSite that an employee is actually deputed to — a
/// specific bank branch, mall department, retail section, etc. (docs/architecture/database/sites-and-units.md
/// §8a). Internally a single generic model regardless of what a given client calls it; the UI
/// always displays the owning site's own `unitLabel` in place of the literal word "Unit". Added
/// 2026-07-03 (Phase 2.5, Checkpoint 1), replacing the removed `ProjectSite.branchCode`. Delete is
/// blocked at the application layer while any Employee or PayrollEntryWorkLine (Phase 3) still
/// references it, with an ON DELETE RESTRICT database-level backstop on those future FKs.
model ProjectUnit {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId    String   @db.Uuid
  name      String   @db.VarChar(160)
  /// The unit's own operational code — the direct successor to the removed
  /// `ProjectSite.branchCode`, now correctly scoped to the specific branch/department it
  /// identifies rather than an entire client site.
  code      String?  @db.VarChar(20)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  site          ProjectSite               @relation(fields: [siteId], references: [id], onDelete: Restrict)
  employees     Employee[]
  transfersFrom EmployeeTransferHistory[] @relation("EmployeeTransferFromUnit")
  transfersTo   EmployeeTransferHistory[] @relation("EmployeeTransferToUnit")
  workLines     PayrollEntryWorkLine[]
  unitReleases  PayrollUnitRelease[]

  // `@@unique([id, siteId])` exists purely so downstream tables (Employee.unitId, added in
  // Checkpoint 2, and PayrollEntryWorkLine.unitId, added in Phase 3 Checkpoint 0) can declare a
  // composite foreign key against it — this is what makes "the unit must belong to the same site
  // as the referencing row" a database-level guarantee rather than an application-layer check
  // alone (docs/architecture/database/sites-and-units.md §8a and docs/architecture/database/employee.md §9 and docs/architecture/database/payroll-entry.md §12a).
  @@unique([siteId, name])
  @@unique([id, siteId])
  @@index([siteId])
}

/// Identity, employment, and bank details for a person on payroll — the Employee Registry
/// (docs/architecture/database/employee.md §9). Master record of *who* someone is, independent of
/// any single month's payroll figures (Principle 1: PayrollEntry owns the monthly figures).
/// Never hard-deleted — `dateOfLeaving` presence marks an employee as having left.
/// **`unitId` added 2026-07-03 (Phase 2.5, Checkpoint 2)**: an employee's *current default* Project
/// Unit — the Branch/Department/Section they're ordinarily rostered to (terminology per
/// `ProjectSite.unitLabel`). Paired with `siteId` via a composite foreign key
/// `(unitId, siteId) -> ProjectUnit(id, siteId)` so Postgres itself rejects any row where the
/// referenced unit doesn't belong to the referenced site — a database-level guarantee, not just an
/// application-layer check. Changing `siteId` and/or `unitId` on an existing Employee is a
/// *transfer* (see `EmployeeTransferHistory`, below), never an incidental field edit.
model Employee {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeCode          String?   @db.VarChar(30)
  cnic                  String?   @db.VarChar(15)
  name                  String    @db.VarChar(160)
  fatherName            String?   @db.VarChar(160)
  religion              String?   @db.VarChar(40)
  dateOfBirth           DateTime? @db.Date
  mobileNumber          String?   @db.VarChar(20)
  designation           String    @db.VarChar(80)
  siteId                String    @db.Uuid
  unitId                String    @db.Uuid
  dateOfJoining         DateTime? @db.Date
  dateOfLeaving         DateTime? @db.Date
  payType               PayType   @default(DAILY_WAGE)
  grossPay              Decimal   @db.Decimal(12, 2)
  bankId                String?   @db.Uuid
  branchCode            String?   @db.VarChar(20)
  accountNumber         String?   @db.VarChar(40)
  /// **Added Negative Payroll Recovery checkpoint (2026-07-26).** `normalizeAccountNumber(accountNumber)`
  /// (shared/src/lib/banking.ts) — uppercased, non-alphanumeric characters stripped. App-maintained
  /// (not a Postgres `GENERATED` column, matching this schema's existing derived-column convention,
  /// e.g. `correctionBalancePayable`) — set by the single write path every create/update/import
  /// flow shares (`employees.service.ts`). Never displayed; exists solely so a partial unique index
  /// (raw SQL, `docs/architecture/database/employee.md §9`) can enforce uniqueness on the *canonical*
  /// account number while `accountNumber` itself keeps whatever formatting was entered.
  accountNumberCanonical String?  @db.VarChar(40)
  /// **Added Phase 4 banking refinement (2026-07-11).** Optional; stored trimmed and uppercase.
  /// Replaces `accountTitle` (removed the same pass) — the account holder is now always the
  /// employee's own legal `name`, never a separately entered/stored string. VARCHAR(34) is the
  /// ISO 13616 international maximum (a Pakistani IBAN is 24 characters).
  iban                  String?   @db.VarChar(34)
  /// **Added Negative Payroll Recovery checkpoint (2026-07-26).** `normalizeIban(iban)` — same
  /// convention as `accountNumberCanonical` immediately above.
  ibanCanonical         String?   @db.VarChar(34)
  defaultEobiAmount     Decimal   @default(400.00) @db.Decimal(10, 2)
  defaultEobiApplicable Boolean   @default(true)
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(6)

  site ProjectSite @relation(fields: [siteId], references: [id], onDelete: Restrict)
  unit ProjectUnit @relation(fields: [unitId, siteId], references: [id, siteId], onDelete: Restrict)
  bank Bank?       @relation(fields: [bankId], references: [id], onDelete: Restrict)

  transferHistory    EmployeeTransferHistory[]
  payrollEntries     PayrollEntry[]
  advances           Advance[]
  /// Phase 6 Checkpoint 1 — schema/domain foundation only.
  balanceAdjustments BalanceAdjustment[]
  correctionPayments CorrectionPayment[]

  // Partial unique indexes (WHERE ... IS NOT NULL) and the CNIC numeric-pattern check constraint
  // are not expressible via Prisma's schema DSL — both are added by raw SQL in the migration
  // (docs/architecture/database/employee.md §9). Negative Payroll Recovery checkpoint (2026-07-26)
  // adds two more partial unique indexes the same way, on accountNumberCanonical/ibanCanonical.
  @@index([siteId])
  @@index([unitId])
  @@index([bankId])
}

/// Dedicated, append-only record of every Employee site/unit transfer
/// (docs/architecture/database/employee.md §8b) — added 2026-07-03 (Phase 2.5, Checkpoint 2),
/// alongside the finalized CNIC/Reactivate decision. Mirrors the existing `BalanceAdjustment`-vs-
/// `AuditLog` pattern: the generic `AuditLog` already captures a `employee.transferred` action for
/// the cross-entity audit trail, but a future Transfer History screen needs typed, directly
/// queryable columns rather than parsing `AuditLog.metadata` JSON. No UI consumes this table yet.
/// Immutable except by direct database intervention — no application code path updates or deletes
/// a row (same convention as `Correction`/`BackupPackage`, application-layer only, no DB trigger
/// unlike `AuditLog`'s stronger guarantee).
model EmployeeTransferHistory {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId          String   @db.Uuid
  fromSiteId          String   @db.Uuid
  toSiteId            String   @db.Uuid
  fromUnitId          String   @db.Uuid
  toUnitId            String   @db.Uuid
  /// The date the transfer actually took effect in the business — deliberately distinct from
  /// `createdAt`, since HR may enter a transfer into the system days or weeks after it happened.
  effectiveDate       DateTime @db.Date
  transferredByUserId String   @db.Uuid
  reason              String?
  remarks             String?
  createdAt           DateTime @default(now()) @db.Timestamptz(6)

  employee      Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  fromSite      ProjectSite @relation("EmployeeTransferFromSite", fields: [fromSiteId], references: [id], onDelete: Restrict)
  toSite        ProjectSite @relation("EmployeeTransferToSite", fields: [toSiteId], references: [id], onDelete: Restrict)
  fromUnit      ProjectUnit @relation("EmployeeTransferFromUnit", fields: [fromUnitId], references: [id], onDelete: Restrict)
  toUnit        ProjectUnit @relation("EmployeeTransferToUnit", fields: [toUnitId], references: [id], onDelete: Restrict)
  transferredBy User        @relation(fields: [transferredByUserId], references: [id], onDelete: Restrict)

  @@index([employeeId, effectiveDate(sort: Desc)])
  @@index([toUnitId, effectiveDate])
  @@index([fromSiteId])
  @@index([toSiteId])
  @@index([fromUnitId])
}

/// Which project sites a Payroll Staff user may access (docs/architecture/authentication.md).
/// Master Admin has implicit, unrestricted access and has no rows here.
model UserSiteAssignment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  siteId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  site ProjectSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([userId, siteId])
  @@index([userId])
  @@index([siteId])
}

/// Permanent, append-only record of every financial and administrative action (Principle 3).
/// Immutability is enforced at two layers: no application code path updates or deletes a row
/// (only `auditLog.record(...)`, an insert), and — for defense in depth — a database trigger
/// (see prisma/migrations/20260701164509_audit_log_immutability) rejects any UPDATE or DELETE
/// against this table outright.
model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurredAt  DateTime @default(now()) @db.Timestamptz(6)
  actorUserId String?  @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @db.VarChar(60)
  entityId    String?  @db.Uuid
  metadata    Json?
  ipAddress   String?  @db.Inet
  userAgent   String?

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([occurredAt(sort: Desc)])
}

/// The standardized classification list for Corrections (Phase 6) — an extensible lookup table
/// instead of a native enum, so a new type is a data row, never a migration (Principle 8).
model AdjustmentType {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.VarChar(40)
  label     String   @db.VarChar(120)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  /// Phase 6 Checkpoint 1 — schema/domain foundation only.
  corrections        Correction[]
  correctionRequests CorrectionRequest[]
  balanceAdjustments BalanceAdjustment[]
}

/// Company name, address, and logo shown on payslips, bank sheets, and the app shell —
/// Master-Admin-only editable. Singleton enforced by a fixed, well-known primary key (see the
/// seed script), so the primary key itself guarantees at most one row can ever exist.
model CompanySettings {
  id                String   @id @db.Uuid
  companyName       String   @db.VarChar(200)
  registeredAddress String?  @db.VarChar(300)
  phone             String?  @db.VarChar(30)
  email             String?  @db.VarChar(255)
  logoStorageKey    String?
  updatedAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedById       String?  @db.Uuid

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

/// Closed, code-coupled set (docs/architecture/database/conventions-and-enums.md §1) — the cycle lifecycle
/// state machine (docs/architecture/workflows/payroll-lifecycle.md §4) everything else keys off.
enum PayrollCycleStatus {
  DRAFT
  RELEASED
  ARCHIVED
}

/// One calendar month's payroll processing run and its lifecycle state
/// (docs/architecture/database/payroll-cycle.md §10). Phase 3 Checkpoint 0 adds only this schema — the
/// explicit "Start First Payroll Cycle" bootstrap action, "Finalize Cycle", and archiving are all
/// later-checkpoint/phase work (docs/IMPLEMENTATION_PLAN.md). `month BETWEEN 1 AND 12` and the
/// partial index `WHERE status = 'DRAFT'` (§10 — "the hot 'which cycle is Draft' lookup") are
/// Prisma-DSL-inexpressible and added by raw SQL in the migration, same pattern as `Employee`'s
/// CNIC check constraint (Phase 2).
model PayrollCycle {
  id                          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  year                        Int                @db.SmallInt
  month                       Int                @db.SmallInt
  status                      PayrollCycleStatus @default(DRAFT)
  sourceCycleId               String?            @db.Uuid
  createdAt                   DateTime           @default(now()) @db.Timestamptz(6)
  createdBy                   String             @db.Uuid
  releasedAt                  DateTime?          @db.Timestamptz(6)
  releasedBy                  String?            @db.Uuid
  archivedAt                  DateTime?          @db.Timestamptz(6)
  archivedBy                  String?            @db.Uuid
  /// **Added Phase 5 Checkpoint 3.** The specific `BackupPackage` version that was `READY` and
  /// committed atomically alongside this cycle's own `ARCHIVED` transition (`archive-and-create-
  /// next`'s single transaction) — never set independently of that transition, and never set for a
  /// cycle archived any other way (there is no other way). `(cycleId, version)` on `BackupPackage`
  /// already answers "which packages exist for this cycle," but not "which one was THE package that
  /// gated this specific archive" once a later correction (Phase 6) can add version 2/3/etc. to an
  /// already-archived cycle — this FK is that direct, queryable answer, additive only.
  archivedWithBackupPackageId String?            @db.Uuid

  sourceCycle                       PayrollCycle?                      @relation("PayrollCycleSource", fields: [sourceCycleId], references: [id], onDelete: Restrict)
  derivedCycles                     PayrollCycle[]                     @relation("PayrollCycleSource")
  createdByUser                     User                               @relation("PayrollCycleCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  releasedByUser                    User?                              @relation("PayrollCycleReleasedBy", fields: [releasedBy], references: [id], onDelete: Restrict)
  archivedByUser                    User?                              @relation("PayrollCycleArchivedBy", fields: [archivedBy], references: [id], onDelete: Restrict)
  archivedWithBackupPackage         BackupPackage?                     @relation("PayrollCycleArchivedWithBackupPackage", fields: [archivedWithBackupPackageId], references: [id], onDelete: Restrict)
  entries                           PayrollEntry[]
  unitReleases                      PayrollUnitRelease[]
  scheduledPayrollPeriods           ScheduledPayrollPeriod[]
  backupPackages                    BackupPackage[]
  /// Phase 6 Checkpoint 1 — schema/domain foundation only.
  balanceAdjustmentsSourced         BalanceAdjustment[]                @relation("BalanceAdjustmentSourceCycle")
  balanceAdjustmentsSettled         BalanceAdjustment[]                @relation("BalanceAdjustmentSettledInCycle")
  balanceAdjustmentSettlements      BalanceAdjustmentSettlement[]
  /// Phase 6 Checkpoint 5 — schema/domain foundation only (Draft-cycle projection reservations).
  balanceAdjustmentMaterializations BalanceAdjustmentMaterialization[]

  @@unique([year, month])
  @@index([archivedWithBackupPackageId])
}

/// **Added Phase 4 Checkpoint 5 (Advances).** The canonical way any module references a calendar
/// payroll period that does not yet have a materialized `PayrollCycle` row — see
/// docs/architecture/database/payroll-cycle.md §10a. Deliberately thin: no status, no lifecycle, no
/// entries — purely a calendar coordinate that resolves into a `PayrollCycle` once one is created
/// for it. Owned exclusively by Payroll Processing (this module); Advances only ever holds a
/// foreign key into this table, never creates/resolves/mutates/deletes a row directly — it calls
/// Payroll Processing's own exposed find-or-create function instead.
model ScheduledPayrollPeriod {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  year           Int       @db.SmallInt
  month          Int       @db.SmallInt
  /// Null until a `PayrollCycle` is actually created for this `(year, month)` — set exactly once,
  /// never again.
  payrollCycleId String?   @db.Uuid
  resolvedAt     DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  payrollCycle PayrollCycle? @relation(fields: [payrollCycleId], references: [id], onDelete: Restrict)

  originalForAdvances Advance[]               @relation("AdvanceOriginalPeriod")
  currentForAdvances  Advance[]               @relation("AdvanceCurrentPeriod")
  scheduleChangesFrom AdvanceScheduleChange[] @relation("AdvanceScheduleChangeFromPeriod")
  scheduleChangesTo   AdvanceScheduleChange[] @relation("AdvanceScheduleChangeToPeriod")

  // `month BETWEEN 1 AND 12` and the partial index `WHERE payrollCycleId IS NULL` are
  // Prisma-DSL-inexpressible and added by raw SQL in the migration.
  @@unique([year, month])
  @@index([payrollCycleId])
}

/// The single editable record of one employee's monthly payroll figures for one cycle — the
/// system's single source of truth (Principle 1, docs/architecture/database/payroll-entry.md §12).
/// Attendance (`days`/`otHours`/`otRate`/`cycleDays`) lives exclusively on the child
/// `PayrollEntryWorkLine` — every entry has at least one line, always (§12a).
///
/// **Deviates from §12 in two approved ways (Phase 3 Checkpoint 0 sign-off), one now closed:**
/// (1) `advanceId`/`eidAdvanceId` — deferred at Checkpoint 0, **now added by Phase 4 Checkpoint 5**,
/// both FKs to the new `Advance` table below.
/// (2) `remarks` IS included even though §12's original column list doesn't have it — an
/// approved addition, editable while the entry is editable, frozen into the permanent snapshot
/// once released, same as every other field (see this file's revision note and
/// `docs/architecture/database/payroll-entry.md` §12's own dated note).
///
/// The numeric `>= 0` check constraints, `released = true ⇒ releasedAt/releasedBy NOT NULL`, and
/// `lateReason IS NOT NULL ⇒ released = true` are Prisma-DSL-inexpressible and added by raw SQL
/// in the migration.
/// Negative Payroll Recovery checkpoint (2026-07-26) — the two non-payment resolutions a
/// `PayrollEntry` can settle into when its Units release but its own `netSalary <= 0`. Mutually
/// exclusive with `released = true` by a raw-SQL CHECK constraint (`released` keeps meaning
/// exactly what it always has — "money was paid" — this enum never redefines it). Set exactly
/// once, at the same release-sweep moment `released`/`releasedAt`/`releasedBy` would otherwise
/// flip; immutable thereafter (`assertEntryEditable`).
enum PayrollEntryPayoutOutcome {
  /// `netSalary = 0` — no payment due, nothing further to settle.
  NO_PAY_DUE
  /// `netSalary < 0` — the employee was overpaid/over-deducted; a `BalanceAdjustment(type:
  /// RECOVERY, originPayrollEntryId: this entry)` is created in the same transaction (see
  /// `docs/architecture/database/release.md`).
  RECOVERY_DUE
}

model PayrollEntry {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cycleId                   String    @db.Uuid
  employeeId                String    @db.Uuid
  siteId                    String    @db.Uuid
  /// **Added Phase 4 Checkpoint 6.1 (Payslips backend foundation, 2026-07-12).** Frozen copy of
  /// `Employee.name`/`.fatherName` at this entry's creation, closing the historical-correctness gap
  /// `bank-sheets.service.ts`'s `buildRow` comment and `PROJECT_PROGRESS.md`'s "Snapshot-name
  /// finding" both flagged as unresolved: Bank Sheet's own "Account Title" still reads
  /// `entry.employee.name` live and is deliberately left that way (out of this checkpoint's scope,
  /// no existing shipped behavior silently changed) — only Payslip generation reads these new
  /// columns. Nullable because pre-existing rows are backfilled best-effort from current `Employee`
  /// data (see this migration's own header comment), not because a newly created entry may
  /// legitimately omit them — `createPayrollEntry`/`createPayrollCycle` always populate both.
  employeeNameSnapshot      String?   @db.VarChar(160)
  fatherNameSnapshot        String?   @db.VarChar(160)
  designation               String    @db.VarChar(80)
  bankId                    String?   @db.Uuid
  branchCode                String?   @db.VarChar(20)
  accountNumber             String?   @db.VarChar(40)
  /// **Added Phase 4 banking refinement (2026-07-11).** Copied from `Employee` at entry creation
  /// (or carried forward at new-cycle creation), then ordinarily Draft-editable — same "copied,
  /// not linked" convention as every other field in this group. Replaces `accountTitle` (removed
  /// the same pass); the account holder is always the entry's own `Employee.name` snapshot.
  iban                      String?   @db.VarChar(34)
  grossPay                  Decimal   @db.Decimal(12, 2)
  allowance                 Decimal   @default(0) @db.Decimal(12, 2)
  leaveDays                 Decimal   @default(0) @db.Decimal(5, 2)
  leaveRate                 Decimal?  @db.Decimal(10, 2)
  eobiAmount                Decimal   @default(400.00) @db.Decimal(10, 2)
  eobiApplicable            Boolean   @default(true)
  advanceDeduction          Decimal   @default(0) @db.Decimal(12, 2)
  /// **Added Phase 4 Checkpoint 5.** The specific `LOAN`-type Advance this cycle's
  /// `advanceDeduction` reduces — recorded at the moment the deduction is entered/materialized,
  /// never re-inferred later from "whichever advance is currently active" (docs/architecture/
  /// database/advances.md §15). Frozen once the entry releases, exactly like every other field here.
  advanceId                 String?   @db.Uuid
  eidAdvanceDeduction       Decimal   @default(0) @db.Decimal(12, 2)
  /// **Added Phase 4 Checkpoint 5.** Same as `advanceId`, for the `EID_ADVANCE`-type Advance this
  /// cycle's `eidAdvanceDeduction` reduces.
  eidAdvanceId              String?   @db.Uuid
  fine                      Decimal   @default(0) @db.Decimal(12, 2)
  /// Phase 6 Checkpoint 5 — sum of this entry's own `BalanceAdjustmentMaterialization` rows whose
  /// `BalanceAdjustment.type = PAYABLE` (always a single, full `DEFERRED` reservation — no partial
  /// PAYABLE materialization exists, mirroring `CorrectionPayment`'s own "no partial" rule).
  /// Recomputed by full re-sum, not incremented, every time a materialization is created for this
  /// entry — always independently reproducible from those rows, never an independent source of
  /// truth. Added to `totalEarning` by `calcNet`.
  correctionBalancePayable  Decimal   @default(0) @db.Decimal(12, 2)
  /// Phase 6 Checkpoint 5 — same convention as `correctionBalancePayable`, for
  /// `BalanceAdjustment.type = RECOVERY` materializations (one or more installment reservations).
  /// Added to `totalDeduction` by `calcNet`.
  correctionBalanceRecovery Decimal   @default(0) @db.Decimal(12, 2)
  hold                      Boolean   @default(false)
  released                  Boolean   @default(false)
  releasedAt                DateTime? @db.Timestamptz(6)
  releasedBy                String?   @db.Uuid
  /// Negative Payroll Recovery checkpoint (2026-07-26). `NULL` for an ordinary Draft entry or one
  /// released for payment (`released = true`); set to `NO_PAY_DUE`/`RECOVERY_DUE` exactly once,
  /// by the same release sweep that would otherwise flip `released`, when this entry's own
  /// `netSalary <= 0`. A raw-SQL CHECK (`payoutOutcome IS NULL OR released = false`) in the
  /// migration enforces the two are mutually exclusive.
  payoutOutcome             PayrollEntryPayoutOutcome?
  lateReason                String?
  /// Approved Phase 3 Checkpoint 0 addition — not in docs/architecture/database/payroll-entry.md §12 as originally
  /// frozen. Editable while the entry is editable; frozen into the permanent snapshot once
  /// released, exactly like every other Draft-editable field.
  remarks                   String?
  /// User-controlled drag-to-reorder position within the cycle. Assigned by the application at
  /// entry-creation time (Checkpoint 1), not a database sequence.
  sortOrder                 Int       @default(0)
  /// Optimistic-locking token — incremented on every update (Checkpoint 1).
  version                   Int       @default(1)
  createdAt                 DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime  @updatedAt @db.Timestamptz(6)

  cycle                             PayrollCycle                       @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  employee                          Employee                           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  site                              ProjectSite                        @relation(fields: [siteId], references: [id], onDelete: Restrict)
  bank                              Bank?                              @relation(fields: [bankId], references: [id], onDelete: Restrict)
  releasedByUser                    User?                              @relation("PayrollEntryReleasedBy", fields: [releasedBy], references: [id], onDelete: Restrict)
  workLines                         PayrollEntryWorkLine[]
  advance                           Advance?                           @relation("PayrollEntryAdvance", fields: [advanceId], references: [id], onDelete: Restrict)
  eidAdvance                        Advance?                           @relation("PayrollEntryEidAdvance", fields: [eidAdvanceId], references: [id], onDelete: Restrict)
  advanceScheduleChanges            AdvanceScheduleChange[]
  /// Phase 6 Checkpoint 1 — schema/domain foundation only.
  corrections                       Correction[]
  correctionRequests                CorrectionRequest[]
  /// Phase 6 Checkpoint 5 — schema/domain foundation only (Draft-cycle projection reservations).
  balanceAdjustmentMaterializations BalanceAdjustmentMaterialization[]
  /// Negative Payroll Recovery checkpoint (2026-07-26) — set only when this entry's own release
  /// created a `RECOVERY` `BalanceAdjustment` directly (`payoutOutcome = RECOVERY_DUE`), never for
  /// a Correction-originated one (see `BalanceAdjustment.originPayrollEntryId`).
  originatedBalanceAdjustment       BalanceAdjustment?

  @@unique([cycleId, employeeId])
  @@index([cycleId])
  @@index([employeeId])
  @@index([cycleId, hold, released])
  @@index([cycleId, hold, released, payoutOutcome])
  @@index([cycleId, siteId])
  /// Added Phase 7 Reports, Employee Payroll History Checkpoint 1A (2026-08-05). The existing
  /// `[cycleId, siteId]` index above is cycleId-led — it serves "one cycle, filter by site"
  /// (Payroll Summary's own shape) but not this report's dominant unfiltered-by-employee shape:
  /// a site-scoped caller's accessible-site filter applied across an *unbounded* cycle range
  /// (e.g. "this Project Site's entire payroll history"), which `[employeeId]` alone (the other
  /// existing index, "one employee, many cycles") also does not cover. `siteId`-led so Postgres
  /// can satisfy "siteId IN (accessible sites)" without a cycle filter and then use `cycleId` as
  /// the index's own second key for the default `(year DESC, month DESC)` ordering this report's
  /// list/export queries apply — see docs/architecture/workflows/reports.md's Employee Payroll
  /// History section for the full query-shape reasoning.
  @@index([siteId, cycleId])
  @@index([bankId])
  @@index([advanceId])
  @@index([eidAdvanceId])
}

/// One employee's attendance at one specific `ProjectUnit`, for one `PayrollEntry`
/// (docs/architecture/database/payroll-entry.md §12a) — always at least one per entry, never zero,
/// never optional (enforced transactionally at write time in Checkpoint 1, not by this schema
/// alone). `siteId` here is a denormalized copy of the parent `PayrollEntry.siteId` at
/// line-creation time, present purely so `unitId` can be composite-FK'd against it — it is not
/// independently FK'd to `ProjectSite` itself (the parent `PayrollEntry.siteId` already is).
/// The business rule that a line's unit must belong to the same site as its parent entry is a
/// database-level guarantee via this composite FK, exactly the same mechanism already proven by
/// `Employee.unitId` (Phase 2.5). The `days >= 0`, `otHours >= 0`, and
/// `cycleDays BETWEEN 1 AND 31` check constraints are Prisma-DSL-inexpressible and added by raw
/// SQL in the migration.
model PayrollEntryWorkLine {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payrollEntryId String   @db.Uuid
  siteId         String   @db.Uuid
  unitId         String   @db.Uuid
  days           Decimal  @default(0) @db.Decimal(5, 2)
  otHours        Decimal  @default(0) @db.Decimal(6, 2)
  otRate         Decimal? @db.Decimal(10, 2)
  cycleDays      Int      @default(30) @db.SmallInt
  /// Display order within the entry; the line with the lowest sortOrder is the entry's "primary"
  /// line for leave-rate-basis purposes (§12).
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  payrollEntry PayrollEntry @relation(fields: [payrollEntryId], references: [id], onDelete: Cascade)
  unit         ProjectUnit  @relation(fields: [unitId, siteId], references: [id, siteId], onDelete: Restrict)

  @@unique([payrollEntryId, unitId])
  @@index([payrollEntryId])
  @@index([unitId])
}

/// The release event for one Project Unit, for one cycle (docs/architecture/database/release.md
/// §12b, Phase 4 Checkpoint 2) — the source of truth `PayrollEntry.released` is derived from.
/// Immutable, append-only: inserted once per `(cycleId, unitId)`, never updated or deleted — there
/// is no "un-release" action (Principle 9). Inserting this row must, in the same transaction,
/// sweep every non-held `PayrollEntry` at this Unit's own Site whose work lines touch `unitId`
/// and, for each one whose every distinct touched Unit now has a release row, flip
/// `PayrollEntry.released`/`releasedAt`/`releasedBy` and write its own `payroll_entry.released`
/// audit entry — see `payroll-release.service.ts`. `PayrollUnitReadiness` ("Ready for Release")
/// and the Late Entry one-off release path are both explicitly deferred past this checkpoint (not
/// built here) — see docs/PROJECT_PROGRESS.md's Phase 4 Checkpoint 2 entry for the scope decision.
model PayrollUnitRelease {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cycleId      String   @db.Uuid
  unitId       String   @db.Uuid
  releasedAt   DateTime @default(now()) @db.Timestamptz(6)
  /// Must hold `payroll:release` for this Unit's Site (Finance or Master User) — enforced at the
  /// application layer, docs/architecture/authentication.md.
  releasedById String   @db.Uuid

  cycle      PayrollCycle @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  unit       ProjectUnit  @relation(fields: [unitId], references: [id], onDelete: Restrict)
  releasedBy User         @relation("PayrollUnitReleaseReleasedBy", fields: [releasedById], references: [id], onDelete: Restrict)

  @@unique([cycleId, unitId])
  @@index([cycleId])
  @@index([unitId])
}

/// Phase 6, Checkpoint 1 (Corrections & Balance Adjustments — domain and schema foundation only).
/// Everything from here to the `BalanceAdjustmentSettlement` model implements the frozen design in
/// `docs/architecture/database/corrections.md` (§11, §13, §13a) and `docs/architecture/database/
/// balance-adjustments.md` (§14, §14a, §14b), refined by the Phase 6 Architecture Review and its
/// Product Decision Resolution (2026-07-18). This checkpoint is schema/domain only — no calculation
/// engine, no approval workflow, no settlement logic, no APIs, no frontend. See each model's own
/// comment for the specific decisions it encodes.

/// Closed, code-coupled set (docs/architecture/database/conventions-and-enums.md §1) — which
/// `PayrollEntry`-adjacent field a `Correction`/`CorrectionRequest` targets. **`DAYS`/`OT_HOURS`/
/// `OT_RATE`/`CYCLE_DAYS` are `PayrollEntryWorkLine` fields, not `PayrollEntry` fields** — the
/// Architecture Review's Decision 1 (Product Decision Resolution, 2026-07-18) restricts these four
/// to entries with exactly one work line; the application layer (not this schema) rejects a request
/// against any of them for a multi-work-line entry with a clear validation message, never a guess or
/// an automatic redistribution across lines. The remaining nine values are always unambiguous
/// `PayrollEntry` scalars. `hold`/`released` are deliberately excluded — workflow state, not
/// correctable payroll data (`docs/architecture/database/payroll-entry.md §12`).
enum CorrectionField {
  GROSS_PAY
  DAYS
  OT_HOURS
  OT_RATE
  ALLOWANCE
  LEAVE_DAYS
  LEAVE_RATE
  CYCLE_DAYS
  EOBI_AMOUNT
  EOBI_APPLICABLE
  ADVANCE_DEDUCTION
  EID_ADVANCE_DEDUCTION
  FINE
}

/// Closed, code-coupled set — the one permitted transition a `CorrectionRequest` ever makes:
/// `PENDING` → `APPROVED` or `PENDING` → `REJECTED`, never edited otherwise once decided
/// (`docs/architecture/database/corrections.md §13a`).
enum CorrectionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A proposed change to one field of a released `PayrollEntry` (`PayrollEntry.released = true`,
/// the single trigger condition — `docs/architecture/workflows/payroll-lifecycle.md §4`), awaiting
/// Master User review. **The pending half of the workflow — separates *proposing* a correction (any
/// authorized payroll user) from *deciding* one (Master User only, `corrections:approve` — Product
/// Decision Resolution Decision 2/Q2, no new permission key).** Bypassed entirely when the Master
/// User corrects directly — see `Correction`, below, which is created already-approved either way;
/// this table exists only for the case where someone *other* than the approver initiated it, or the
/// Master User chooses to formalize their own proposal first (never required).
///
/// Immutable with exactly one permitted transition — never edited otherwise once decided
/// (`PENDING` is the only state that can change, and only once). No DB trigger (matching
/// `EmployeeTransferHistory`'s own precedent: application-layer-only immutability is this
/// codebase's established convention for every table except `AuditLog` itself, which alone gets the
/// stronger DB-trigger guarantee).
model CorrectionRequest {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payrollEntryId        String                  @db.Uuid
  field                 CorrectionField
  /// The requester's proposed value — a starting point for review, not binding; the eventual
  /// `Correction.newValue` may differ if the Master User adjusts it during approval.
  proposedNewValue      String                  @db.VarChar(80)
  /// The requester's proposed classification, likewise revisable at approval.
  adjustmentTypeId      String                  @db.Uuid
  reason                String
  requestedById         String                  @db.Uuid
  requestedAt           DateTime                @default(now()) @db.Timestamptz(6)
  status                CorrectionRequestStatus @default(PENDING)
  /// The Master User who approved or rejected — null while `PENDING`.
  reviewedById          String?                 @db.Uuid
  reviewedAt            DateTime?               @db.Timestamptz(6)
  /// Mandatory when `status = REJECTED` (mirrors `Correction.reason`'s "reason mandatory"
  /// convention, applied symmetrically to rejection); always null otherwise.
  rejectionReason       String?
  /// Set only on approval, never on rejection — the `Correction` this request produced.
  resultingCorrectionId String?                 @unique @db.Uuid

  payrollEntry        PayrollEntry   @relation(fields: [payrollEntryId], references: [id], onDelete: Restrict)
  adjustmentType      AdjustmentType @relation(fields: [adjustmentTypeId], references: [id], onDelete: Restrict)
  requestedBy         User           @relation("CorrectionRequestRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy          User?          @relation("CorrectionRequestReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  resultingCorrection Correction?    @relation(fields: [resultingCorrectionId], references: [id], onDelete: Restrict)

  @@index([payrollEntryId])
  @@index([status])
  @@index([requestedById])
  @@index([reviewedById])
}

/// A single approved change to one field of a released `PayrollEntry` — the only permitted
/// mechanism for changing a locked entry's outcome, never a direct edit
/// (`docs/architecture/database/payroll-entry.md §12`'s immutability rule; Principle 9). **Always
/// created already-approved** — whether a Master User corrected directly or approved a
/// `CorrectionRequest` (above), both paths produce an identical row; nothing downstream
/// distinguishes which path produced it. Fully immutable from creation, no further states ever
/// (Product Decision Resolution Decision 5/Q6 — deliberately no `Draft`/`Cancelled`/`Superseded`
/// lifecycle; a mistaken correction is corrected via a new `Correction`, never by editing this row).
///
/// **`employeeId`/`sourceCycleId`/target-cycle/financial-classification are deliberately NOT
/// duplicated here** — they live on `BalanceAdjustment` (below), the one place this domain's live
/// financial state is tracked, per "avoid duplicated financial state" (Architecture Review §3). This
/// row is derivable to its own `PayrollEntry` → `Employee`/cycle via `payrollEntryId` alone.
model Correction {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payrollEntryId       String          @db.Uuid
  field                CorrectionField
  /// String representation of the field's *current effective* value immediately before this
  /// correction — reflecting any prior approved correction to this same field, not necessarily the
  /// original `PayrollEntry` value. See "Baseline Reconstruction" (`docs/architecture/workflows/
  /// corrections-and-balance-adjustments.md`) — computed and validated by Checkpoint 2, not this one.
  oldValue             String          @db.VarChar(80)
  newValue             String          @db.VarChar(80)
  /// `calcNet` result on the entry's current effective state, before this change.
  oldNetSalary         Decimal         @db.Decimal(12, 2)
  /// `calcNet` result after this change — a trial computation, never written back to `PayrollEntry`.
  newNetSalary         Decimal         @db.Decimal(12, 2)
  adjustmentTypeId     String          @db.Uuid
  reason               String
  /// The Master User who approved this correction — for a direct correction, also its creator (the
  /// same act, same person, same moment; there is no separate "creator" field, since Correction is
  /// never created in any state other than already-approved). For a `CorrectionRequest`-originated
  /// correction, the original proposer is `CorrectionRequest.requestedById`, not this column.
  approvedById         String          @db.Uuid
  approvedAt           DateTime        @default(now()) @db.Timestamptz(6)
  /// **Added Phase 6 Checkpoint 1 (Product Decision Resolution Decision 5/Q6, resolving a conflict
  /// between Decision 3's Corrections Ledger field list and Q6's original "no linked-record concept
  /// needed" recommendation).** Nullable self-reference to the prior `Correction` this one reverses.
  /// A reversal is still an ordinary `Correction` — same table, same always-approved lifecycle, no
  /// new status or type — this column only makes that relationship structurally queryable for the
  /// Ledger (Checkpoint 6) instead of relying on parsing free-text `reason`. Null for an ordinary,
  /// non-reversing correction (the common case).
  reversesCorrectionId String?         @db.Uuid

  payrollEntry          PayrollEntry       @relation(fields: [payrollEntryId], references: [id], onDelete: Restrict)
  adjustmentType        AdjustmentType     @relation(fields: [adjustmentTypeId], references: [id], onDelete: Restrict)
  approvedBy            User               @relation("CorrectionApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  reversesCorrection    Correction?        @relation("CorrectionReversal", fields: [reversesCorrectionId], references: [id], onDelete: Restrict)
  reversedByCorrections Correction[]       @relation("CorrectionReversal")
  correctionRequest     CorrectionRequest?
  balanceAdjustment     BalanceAdjustment?

  @@index([payrollEntryId])
  @@index([payrollEntryId, field, approvedAt(sort: Desc)])
  @@index([adjustmentTypeId])
  @@index([approvedAt])
  @@index([approvedById])
  @@index([reversesCorrectionId])
}

/// Closed, code-coupled set — `PAYABLE` (the company owes the employee more), `RECOVERY` (the
/// employee was overpaid), or `NONE` (zero net difference — still creates a row, for full
/// traceability, but already `SETTLED` at creation).
enum BalanceAdjustmentType {
  PAYABLE
  RECOVERY
  NONE
}

/// Closed, code-coupled set — a `NONE`-type row is created already `SETTLED`; every other row starts
/// `PENDING` and settles exactly once (`RECOVERY` may take several cycles of installments to reach
/// `remainingAmount = 0`, but the transition itself, `PENDING` → `SETTLED`, still happens exactly
/// once, at that final installment).
enum BalanceAdjustmentStatus {
  PENDING
  SETTLED
}

/// Closed, code-coupled set — meaningful only for `type = PAYABLE`; always `NULL` for
/// `RECOVERY`/`NONE` (negative balances have no immediate option; `NONE` needs no timing at all).
enum BalanceAdjustmentPaymentTiming {
  IMMEDIATE
  DEFERRED
}

/// The standalone, traceable balance created by an approved `Correction` — never folded silently
/// into an ordinary payroll field (`docs/architecture/workflows/corrections-and-balance-adjustments.md`).
/// Created for **every** approved correction, with no exception, including a zero-net-difference
/// correction (`type = NONE`). This is the one place this domain's live financial state lives —
/// `remainingAmount` is the single authoritative "how much is still owed" figure; nothing else in
/// this schema independently tracks it. **No settlement logic is implemented by this checkpoint** —
/// `status`/`remainingAmount`/`settledInCycleId`/`settledAt` exist as columns only; the automatic
/// settlement pipeline (Automatic Settlement Workflow) is Checkpoint 3.
model BalanceAdjustment {
  id                        String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// **Made nullable, Negative Payroll Recovery checkpoint (2026-07-26).** Exactly one of
  /// `correctionId`/`originPayrollEntryId` is set, enforced by a raw-SQL CHECK constraint (a
  /// UNIQUE constraint on a nullable column already permits multiple `NULL`s in Postgres, so no
  /// partial index is needed here). Set for the original, Correction-originated path — a
  /// post-release adjustment approved through `CorrectionRequest`/`approveCorrectionRequest`.
  correctionId              String?                         @unique @db.Uuid
  /// **Added Negative Payroll Recovery checkpoint (2026-07-26).** Set instead of `correctionId`
  /// when this `RECOVERY` row was created directly from a still-Draft `PayrollEntry` whose own
  /// current-cycle `netSalary` came out negative at release time — a distinct trigger from the
  /// Correction workflow (which requires the entry to already be `released`), reusing the exact
  /// same `BalanceAdjustment` lifecycle/materialization/settlement machinery unchanged. See
  /// `docs/architecture/database/release.md`.
  originPayrollEntryId      String?                         @unique @db.Uuid
  /// Denormalized from `correction → payrollEntry → employee` (or, for a negative-payroll-origin
  /// row, from `originPayrollEntry → employee`) for fast "pending balances for employee X"
  /// lookups — always derived server-side, never accepted as independent input. The one
  /// deliberate denormalization in this domain (unlike `Correction`, which stays
  /// derivable-only) — justified here by the hot settlement-sweep query path.
  employeeId                String                          @db.Uuid
  /// The cycle the correction was made against — may be `Released` or `Archived`, or a still-`Draft`
  /// cycle in which this specific entry was individually released (Late Entry).
  sourceCycleId             String                          @db.Uuid
  adjustmentTypeId          String                          @db.Uuid
  /// Absolute value, the *original total* — `0` only when `type = NONE`. For `RECOVERY`, stays the
  /// original total even as it's recovered in installments; see `remainingAmount` for the live
  /// outstanding figure.
  amount                    Decimal                         @db.Decimal(12, 2)
  type                      BalanceAdjustmentType
  status                    BalanceAdjustmentStatus         @default(PENDING)
  /// Set at approval time; meaningful only for `type = PAYABLE`.
  paymentTiming             BalanceAdjustmentPaymentTiming?
  /// The per-cycle amount to recover; `NULL` means "recover the full `remainingAmount` in the next
  /// cycle." `RECOVERY`-only, staff-editable at any time before `remainingAmount` reaches zero
  /// (Checkpoint 3+ — not enforced by this checkpoint).
  recoveryInstallmentAmount Decimal?                        @db.Decimal(12, 2)
  /// The live outstanding balance still to be recovered/paid — decremented by each
  /// `BalanceAdjustmentSettlement` application, reaching `0` exactly when `status` flips to
  /// `SETTLED`. Defaults to `amount` at creation (enforced at the application layer, not a DB
  /// default expression, since it must always equal whatever `amount` this specific row was created
  /// with).
  remainingAmount           Decimal                         @db.Decimal(12, 2)
  /// Auto-composed display remark shown on the Payslip and Corrections Ledger (Checkpoint 6).
  remark                    String
  /// Set only at final settlement; always null for a `NONE`-type row (settled outside any cycle).
  settledInCycleId          String?                         @db.Uuid
  settledAt                 DateTime?                       @db.Timestamptz(6)
  createdAt                 DateTime                        @default(now()) @db.Timestamptz(6)

  correction        Correction?                        @relation(fields: [correctionId], references: [id], onDelete: Restrict)
  /// **Added Negative Payroll Recovery checkpoint (2026-07-26).** The still-Draft-at-the-time
  /// `PayrollEntry` whose own negative `netSalary` created this row (mutually exclusive with
  /// `correction`, see `correctionId`/`originPayrollEntryId` comments above).
  originPayrollEntry PayrollEntry?                      @relation(fields: [originPayrollEntryId], references: [id], onDelete: Restrict)
  employee          Employee                           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  sourceCycle       PayrollCycle                       @relation("BalanceAdjustmentSourceCycle", fields: [sourceCycleId], references: [id], onDelete: Restrict)
  adjustmentType    AdjustmentType                     @relation(fields: [adjustmentTypeId], references: [id], onDelete: Restrict)
  settledInCycle    PayrollCycle?                      @relation("BalanceAdjustmentSettledInCycle", fields: [settledInCycleId], references: [id], onDelete: Restrict)
  correctionPayment CorrectionPayment?
  settlements       BalanceAdjustmentSettlement[]
  /// Phase 6 Checkpoint 5 — schema/domain foundation only (Draft-cycle projection reservations).
  materializations  BalanceAdjustmentMaterialization[]

  @@index([employeeId, status])
  @@index([status])
  @@index([adjustmentTypeId, status])
  @@index([sourceCycleId])
  @@index([settledInCycleId])
}

/// The standalone artifact for an `IMMEDIATE PAYABLE` `BalanceAdjustment` when the employee has no
/// already-open `PayrollEntry` to fold it into — generates its own one-off Bank Sheet/Cash
/// Sheet-style document rather than waiting for or modifying any `PayrollEntry`. Immutable,
/// append-only, same convention as `Correction`/`AuditLog`. **No document generation or settlement
/// logic is implemented by this checkpoint** — this is the schema only.
model CorrectionPayment {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  balanceAdjustmentId String   @unique @db.Uuid
  /// Denormalized, same convention as `BalanceAdjustment.employeeId`.
  employeeId          String   @db.Uuid
  /// Always equals the settling `BalanceAdjustment.remainingAmount` at the moment of payment.
  amount              Decimal  @db.Decimal(12, 2)
  /// Snapshot copied from `Employee`/`PayrollEntry` at payment time — **copied not linked**, same
  /// convention as `PayrollEntry`'s own bank fields, so a later `Employee` bank-detail change never
  /// retroactively alters a historical payment record.
  bankId              String?  @db.Uuid
  branchCode          String?  @db.VarChar(20)
  accountNumber       String?  @db.VarChar(40)
  iban                String?  @db.VarChar(34)
  paidAt              DateTime @default(now()) @db.Timestamptz(6)
  /// The Finance user who executed the payment.
  paidById            String   @db.Uuid

  balanceAdjustment BalanceAdjustment @relation(fields: [balanceAdjustmentId], references: [id], onDelete: Restrict)
  employee          Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  bank              Bank?             @relation(fields: [bankId], references: [id], onDelete: Restrict)
  paidBy            User              @relation("CorrectionPaymentPaidBy", fields: [paidById], references: [id], onDelete: Restrict)

  @@index([employeeId])
}

/// Append-only history of each cycle's partial recovery application against an installment-based
/// `RECOVERY` `BalanceAdjustment` — the business-history counterpart to `AuditLog`, following the
/// same precedent already established by `EmployeeTransferHistory`. One row per cycle in which an
/// installment was actually applied, so the Corrections Ledger (Checkpoint 6) can show a clean
/// per-cycle recovery breakdown without parsing `AuditLog.metadata` JSON. **No settlement logic is
/// implemented by this checkpoint** — this table exists so Checkpoint 3 has somewhere to write to.
model BalanceAdjustmentSettlement {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  balanceAdjustmentId String   @db.Uuid
  /// The cycle whose release applied this installment.
  cycleId             String   @db.Uuid
  /// `min(recoveryInstallmentAmount ?? remainingAmount-at-the-time, remainingAmount-at-the-time)` —
  /// may be less than the standing installment amount if it's the final, smaller-than-usual one.
  amountApplied       Decimal  @db.Decimal(12, 2)
  appliedAt           DateTime @default(now()) @db.Timestamptz(6)

  balanceAdjustment BalanceAdjustment                 @relation(fields: [balanceAdjustmentId], references: [id], onDelete: Restrict)
  cycle             PayrollCycle                      @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  /// Phase 6 Checkpoint 5 — the reservation this settlement consumed, where applicable. Set, as of
  /// Phase 6 Checkpoint 7 (`corrections.materialization.service.ts`'s
  /// `consumeMaterializationsForReleasedEntries`), at the same moment a
  /// `BalanceAdjustmentMaterialization` flips `ACTIVE` -> `CONSUMED` — inside `releaseProjectUnit`'s
  /// own transaction, the exact moment the reserved `PayrollEntry` actually releases; null for a
  /// settlement that never went through a materialization reservation at all (a standalone
  /// `CorrectionPayment`-adjacent settlement, or any manually-recorded settlement not preceded by
  /// materialization).
  materialization   BalanceAdjustmentMaterialization?

  @@unique([balanceAdjustmentId, cycleId])
  @@index([balanceAdjustmentId])
  @@index([cycleId])
}

/// Closed, code-coupled set — the `BalanceAdjustmentMaterialization` lifecycle. `ACTIVE` is the
/// only state Phase 6 Checkpoint 5 itself ever sets (Checkpoint 5 is Draft-cycle *projection*
/// only, never settlement, per the Product Decision Resolution boundary). `CONSUMED` is set by
/// Phase 6 Checkpoint 7's release-time consumption (`releaseProjectUnit` ->
/// `consumeMaterializationsForReleasedEntries`) the moment the reserving `PayrollEntry` actually
/// releases. `CANCELLED` remains unset by any checkpoint through 7 — no rollback/lifecycle
/// requirement has yet proven it necessary (see the one known edge case this leaves open:
/// `docs/architecture/workflows/corrections-and-balance-adjustments.md`'s own Checkpoint 7 scope
/// note, "an entry `hold`-marked after its obligation already materialized").
enum MaterializationStatus {
  ACTIVE
  CONSUMED
  CANCELLED
}

/// Phase 6 Checkpoint 5 — the immutable, per-adjustment, per-cycle *reservation* record: "this
/// outstanding obligation has been projected into this Draft PayrollEntry's calculation." A
/// materialization is deliberately not a settlement — creating one never touches
/// `BalanceAdjustment.remainingAmount`/`.status`, `CorrectionPayment`, or
/// `BalanceAdjustmentSettlement`. Instead it *reserves* part of the adjustment's remaining balance
/// so a later Draft cycle cannot re-project the same money: `availableToMaterialize =
/// remainingAmount - SUM(amount WHERE status = 'ACTIVE')`, across every cycle for that adjustment,
/// not just the current one. `CONSUMED` rows are excluded from that sum by design — once a
/// materialization is actually settled, `remainingAmount` itself has already dropped by the same
/// amount, so counting the (by-then-stale) reservation a second time would double-subtract.
///
/// `PayrollEntry.correctionBalancePayable`/`.correctionBalanceRecovery` are aggregates derived from
/// these rows for a given entry — always reproducible by re-summing them, never an independent
/// source of truth. Phase 6 Checkpoint 7's `ACTIVE` -> `CONSUMED` transition
/// (`consumeMaterializationsForReleasedEntries`) validates, transactionally, that the
/// `BalanceAdjustmentSettlement` it creates (`settlementId`) references the *same*
/// `balanceAdjustmentId` and `cycleId` as this row by construction — it always creates both from
/// the same materialization row in the same transaction, never linking to a pre-existing,
/// independently-created settlement; application-layer only, deliberately not a DB constraint
/// (would require unnecessary column duplication across two already-linked tables).
model BalanceAdjustmentMaterialization {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  balanceAdjustmentId String                @db.Uuid
  payrollEntryId      String                @db.Uuid
  /// Denormalized from `payrollEntry.cycleId` — present so `@@unique([balanceAdjustmentId, cycleId])`
  /// can enforce "one materialization per adjustment per target cycle" directly, without a join.
  cycleId             String                @db.Uuid
  amount              Decimal               @db.Decimal(12, 2)
  status              MaterializationStatus @default(ACTIVE)
  /// Set by Phase 6 Checkpoint 7's release-time consumption — see this model's own comment and
  /// `BalanceAdjustmentSettlement.materialization`, above. `@unique` so one settlement can never be
  /// credited as consuming more than one reservation.
  settlementId        String?               @unique @db.Uuid
  consumedAt          DateTime?             @db.Timestamptz(6)
  cancelledAt         DateTime?             @db.Timestamptz(6)
  createdAt           DateTime              @default(now()) @db.Timestamptz(6)

  balanceAdjustment BalanceAdjustment            @relation(fields: [balanceAdjustmentId], references: [id], onDelete: Restrict)
  payrollEntry      PayrollEntry                 @relation(fields: [payrollEntryId], references: [id], onDelete: Restrict)
  cycle             PayrollCycle                 @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  settlement        BalanceAdjustmentSettlement? @relation(fields: [settlementId], references: [id], onDelete: Restrict)

  @@unique([balanceAdjustmentId, cycleId])
  @@index([balanceAdjustmentId, status])
  @@index([payrollEntryId])
  @@index([cycleId])
}

/// Closed, code-coupled set (docs/architecture/database/conventions-and-enums.md §1) — a lightweight,
/// deliberately non-extensible set for the Tasks Workspace (docs/architecture/database/tasks.md §27,
/// Phase 3.5). A new priority level would be a real UI/behavior decision, not a data row.
enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

/// Closed, code-coupled set — the Task lifecycle (docs/architecture/database/tasks.md §27).
/// Deliberately no IN_PROGRESS value (frozen decision, 2026-07-10): evaluated and rejected as
/// unnecessary granularity for a lightweight delegation list.
enum TaskStatus {
  TO_DO
  COMPLETED
  CANCELLED
}

/// Closed, code-coupled set — the only three notification events this system ever persists
/// (docs/architecture/database/tasks.md §27a). Due-today/overdue are deliberately NOT represented
/// here; they are computed live from Task.dueDate/Task.status, never stored.
enum TaskNotificationType {
  ASSIGNED
  REASSIGNED
  COMPLETED
}

/// A single unit of internally-delegated work (docs/architecture/database/tasks.md §27, Phase 3.5)
/// — Master User assigns something to exactly one other user and tracks whether it gets done. Not a
/// project-management tool: no subtasks, no dependencies, no recurrence, no comment thread — those
/// are permanently out of scope, not deferred (see the file-level revision note in
/// docs/architecture/database/tasks.md). Permanently replaces the previously-planned Team
/// Collaboration/Chat panel (reference/PROJECT_SPEC.md, reference/payroll_prototype.html — both
/// frozen, unedited historical reference; this schema is the current authority).
/// Ownership-based visibility, not site- or role-based: a task is visible only to Master User and
/// the one user in `assignedToUserId` — see docs/architecture/authentication.md's "Tasks:
/// ownership-based visibility" section. Deliberately carries no optimistic-locking `version` column
/// — at most two people ever touch one row, writing disjoint fields (Master User owns every
/// field-level mutation; the assignee's only possible write is the completion flip), unlike
/// PayrollEntry's genuine multi-editor exposure (docs/architecture/database/schema-invariants.md
/// §22).
model Task {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title             String       @db.VarChar(200)
  description       String?
  assignedToUserId  String       @db.Uuid
  assignedByUserId  String       @db.Uuid
  /// Set on creation; updated whenever `assignedToUserId` changes (a reassignment) — drives the
  /// "Recently Assigned" sort and the `task.reassigned` notification's timing, independent of
  /// `createdAt`.
  assignedAt        DateTime     @default(now()) @db.Timestamptz(6)
  priority          TaskPriority @default(MEDIUM)
  status            TaskStatus   @default(TO_DO)
  dueDate           DateTime?    @db.Date
  /// Free text, not a native enum, by deliberate choice — mirrors AuditLog.entityType's own
  /// convention, since the set of "modules a task might be about" grows every phase and a native
  /// enum would force a migration each time one does.
  module            String?      @db.VarChar(60)
  /// Polymorphic reference, reusing AuditLog's own entityType/entityId shape rather than inventing
  /// a second pattern for the same idea.
  relatedEntityType String?      @db.VarChar(60)
  /// No FK constraint (same reasoning as AuditLog.entityId — the referenced table varies).
  relatedEntityId   String?      @db.Uuid
  createdAt         DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(6)
  /// Set when `status` becomes COMPLETED; cleared on reopen.
  completedAt       DateTime?    @db.Timestamptz(6)

  assignedTo    User               @relation("TaskAssignedTo", fields: [assignedToUserId], references: [id], onDelete: Restrict)
  assignedBy    User               @relation("TaskAssignedBy", fields: [assignedByUserId], references: [id], onDelete: Restrict)
  notifications TaskNotification[]

  @@index([assignedToUserId])
  @@index([dueDate])
  @@index([priority])
  @@index([assignedAt])
  @@index([status])
}

/// The persisted half of the in-app Task notification model (docs/architecture/database/tasks.md
/// §27a, Phase 3.5) — one row per discrete event a user should be told about. Due-today/overdue are
/// NOT rows here; they are computed live from Task.dueDate/Task.status at read time. No
/// WebSockets/SSE — delivered via ordinary client polling (docs/architecture/authentication.md's
/// Postgres-over-Redis reasoning applies identically here). Deliberately scoped to Tasks only, not a
/// general-purpose notification system — a second real consumer would be the trigger to generalize
/// this, not anticipated demand.
model TaskNotification {
  id        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String               @db.Uuid
  taskId    String               @db.Uuid
  type      TaskNotificationType
  createdAt DateTime             @default(now()) @db.Timestamptz(6)
  /// Null = unread; the badge count is COUNT(*) WHERE userId = :current AND readAt IS NULL.
  readAt    DateTime?            @db.Timestamptz(6)

  /// Both FKs CASCADE — unlike AuditLog (SET NULL on actor deletion) or Task itself (RESTRICT), a
  /// notification has no standalone historical value once its User or Task is gone; it is ephemeral
  /// UI state, not a record of what happened. A deliberate, narrow exception to this schema's
  /// general RESTRICT-by-default convention, not an inconsistency.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

/// Closed, code-coupled set (docs/architecture/database/conventions-and-enums.md §1) — Phase 4
/// Checkpoint 5 (Advances).
enum AdvanceType {
  LOAN
  EID_ADVANCE
}

/// Closed, code-coupled set — informational only per the original spec ("no auto-calculation of
/// installment size"); does not drive any system-computed behavior on its own.
enum AdvanceRepaymentType {
  FULL_DEDUCTION
  INSTALLMENT
}

/// Closed, code-coupled set — an Advance's lifecycle. `PAID_OFF` is reached only once the
/// `PayrollEntry` whose deduction zeroed `outstandingBalance` is actually Released — never set
/// directly by a user action, and never set merely because a Draft deduction reached zero (see
/// `RESERVED`, and the `Advance` model's own doc comment for the full lifecycle).
enum AdvanceStatus {
  ACTIVE
  /// Added Presentation & Workflow Stabilization Checkpoint, 2026-07-25 — `outstandingBalance` has
  /// reached zero from a deduction materialized into a still-Draft (unreleased) `PayrollEntry`, but
  /// that entry has not yet Released, so the reservation is not yet final. Reverts to `ACTIVE` if
  /// that deduction is reversed (edit/defer/cancel) before release; advances to `PAID_OFF` the
  /// moment the entry actually releases (`settleAdvancesForReleasedEntries`, advances.service.ts).
  RESERVED
  PAID_OFF
  /// Added Operational Stabilization Checkpoint, 2026-07-24 — see the `Advance` model's own doc
  /// comment for the full rationale (a non-destructive correction for a mistaken Advance).
  CANCELLED
}

/// A record of a loan or Eid advance given to an employee, and its remaining balance (Phase 4
/// Checkpoint 5, docs/architecture/database/advances.md §15). At most one `ACTIVE`-or-`RESERVED`
/// Advance may exist per employee per type at any time (approved, frozen architecture decision,
/// widened for `RESERVED` at the Presentation & Workflow Stabilization Checkpoint, 2026-07-25) —
/// enforced by a partial unique index (raw SQL in the migration; Prisma's schema DSL cannot express
/// a conditional unique index) and re-checked at the application layer before every create.
///
/// **`scheduledInstallmentAmount`** is an additive field beyond docs/architecture/database/
/// advances.md §15's original column list — anticipated by name in docs/IMPLEMENTATION_PLAN.md's
/// Phase 4 section as a "proposed schema addition... not yet implemented," now implemented here.
/// It is what lets an `INSTALLMENT`-type Advance's deduction materialize automatically at new-cycle
/// creation without the system ever computing the amount itself (Principle: "no value is ever
/// computed by the system, only repeated forward until staff changes it" — the 2026-07-02
/// "Automatic Payroll Recovery" clarification). Null means no standing schedule yet (or a one-off
/// `FULL_DEDUCTION` advance, which never uses this field at all).
///
/// **`paidOffAt`** is likewise additive beyond §15's original column list — required permanent
/// history ("paid-off date, when applicable") this checkpoint's own requirements call for; set once,
/// the instant `status` transitions to `PAID_OFF` at actual Payroll Release (never at the earlier
/// `RESERVED` stage — see `AdvanceStatus`), never cleared or changed again.
///
/// Never hard-deletable — no delete path exists at the application layer, matching this schema's
/// established convention for every other permanent financial/master record (Employee, Bank's
/// protected Cash row). "Amount recovered" (`totalAmount - outstandingBalance`) is calculated on
/// read, never stored, per Principle 5/6 — the same convention `netSalary` already follows.
///
/// **`CANCELLED` status (added Operational Stabilization Checkpoint, 2026-07-24).** A user-facing
/// correction for an Advance entered by mistake — deliberately a status transition, not a delete,
/// for exactly the same reason the paragraph above already forbids hard-deleting this table: an
/// Advance is a permanent financial/master record. This applies uniformly regardless of whether any
/// deduction has yet materialized (an advance recorded against the wrong employee/amount/start cycle
/// with zero history is corrected by cancelling it and recording a fresh one, never by deleting the
/// mistaken row). Cancelling reverses any deduction still sitting on a Draft (unreleased)
/// `PayrollEntry` — the same reversal `deferAdvanceSchedule` already performs — but never touches a
/// RELEASED deduction. `currentScheduledPeriodId` is cleared, same as `PAID_OFF`, so a cancelled
/// Advance is excluded from every future materialization sweep
/// (`materializeScheduledAdvanceDeductions` already filters `status: 'ACTIVE'` only). The partial
/// unique index below is `WHERE status = 'ACTIVE'` only, so a new Advance of the same type may be
/// recorded immediately after cancellation, exactly as after `PAID_OFF`.
model Advance {
  id                         String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId                 String               @db.Uuid
  type                       AdvanceType
  totalAmount                Decimal              @db.Decimal(12, 2)
  /// Decremented as matching `PayrollEntry` deductions materialize; reaching zero flips `status`
  /// to `RESERVED` (not yet `PAID_OFF` — see `AdvanceStatus`). The only two paths that ever change
  /// this: the automatic cycle-bootstrap materialization below, and (once Phase 6 exists) an
  /// approved Correction reconciliation.
  outstandingBalance         Decimal              @db.Decimal(12, 2)
  dateGiven                  DateTime             @db.Date
  repaymentType              AdvanceRepaymentType
  /// See the model-level doc comment above.
  scheduledInstallmentAmount Decimal?             @db.Decimal(12, 2)
  notes                      String?
  status                     AdvanceStatus        @default(ACTIVE)
  originalScheduledPeriodId  String?              @db.Uuid
  currentScheduledPeriodId   String?              @db.Uuid
  paidOffAt                  DateTime?            @db.Timestamptz(6)
  createdAt                  DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime             @updatedAt @db.Timestamptz(6)

  employee                   Employee                @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  originalScheduledPeriod    ScheduledPayrollPeriod? @relation("AdvanceOriginalPeriod", fields: [originalScheduledPeriodId], references: [id], onDelete: Restrict)
  currentScheduledPeriod     ScheduledPayrollPeriod? @relation("AdvanceCurrentPeriod", fields: [currentScheduledPeriodId], references: [id], onDelete: Restrict)
  scheduleChanges            AdvanceScheduleChange[]
  payrollEntriesAsAdvance    PayrollEntry[]          @relation("PayrollEntryAdvance")
  payrollEntriesAsEidAdvance PayrollEntry[]          @relation("PayrollEntryEidAdvance")

  // Partial unique index `(employeeId, type) WHERE status IN ('ACTIVE', 'RESERVED')` and the check
  // constraints (`totalAmount > 0`, `outstandingBalance >= 0 AND outstandingBalance <=
  // totalAmount`, `status IN ('PAID_OFF', 'RESERVED') ⇒ currentScheduledPeriodId IS NULL`) are
  // Prisma-DSL-inexpressible and added by raw SQL in the migration.
  @@index([employeeId])
  @@index([currentScheduledPeriodId])
}

/// The append-only history of every change made to an Advance's scheduled deduction period (Phase 4
/// Checkpoint 5, docs/architecture/database/advances.md §15a). Named for what it records — changes
/// to the schedule — not the schedule itself, which always lives on
/// `Advance.currentScheduledPeriodId`. No updates, no deletes, only inserts — same convention as
/// `EmployeeTransferHistory`/`PayrollUnitRelease`.
model AdvanceScheduleChange {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  advanceId      String   @db.Uuid
  /// The entry this change removed the materialized deduction from — deferral only ever operates
  /// on a deduction that has already materialized into a real, still-Draft `PayrollEntry`; there is
  /// no "reschedule before it ever lands" action (see the architecture review's reasoning).
  payrollEntryId String   @db.Uuid
  fromPeriodId   String   @db.Uuid
  toPeriodId     String   @db.Uuid
  reason         String
  changedById    String   @db.Uuid
  changedAt      DateTime @default(now()) @db.Timestamptz(6)

  advance      Advance                @relation(fields: [advanceId], references: [id], onDelete: Restrict)
  payrollEntry PayrollEntry           @relation(fields: [payrollEntryId], references: [id], onDelete: Restrict)
  fromPeriod   ScheduledPayrollPeriod @relation("AdvanceScheduleChangeFromPeriod", fields: [fromPeriodId], references: [id], onDelete: Restrict)
  toPeriod     ScheduledPayrollPeriod @relation("AdvanceScheduleChangeToPeriod", fields: [toPeriodId], references: [id], onDelete: Restrict)
  changedBy    User                   @relation(fields: [changedById], references: [id], onDelete: Restrict)

  // `length(trim(reason)) > 0` is Prisma-DSL-inexpressible and added by raw SQL in the migration.
  // The "target must be strictly future" rule (BR-ADV-006) has no database-level backstop —
  // enforced at the application layer only, per the same reasoning already documented for this
  // table in docs/architecture/database/advances.md §15a.
  @@index([advanceId, changedAt(sort: Desc)])
  @@index([payrollEntryId])
}

/// Phase 5 Checkpoint 2 (Backup Packages, docs/architecture/database/payroll-cycle.md §17). A
/// `GENERATING` row is created the instant a version number is reserved (before any storage write
/// begins — the concurrency backstop, see `backup-packages.service.ts`); it transitions to exactly
/// one of `READY`/`FAILED` and never changes again after that. There is deliberately no `PARTIAL`
/// or similar — a package is either fully generated and downloadable or it failed; see this
/// checkpoint's own architecture review for the confirmed invariant.
enum BackupPackageStatus {
  GENERATING
  READY
  FAILED
}

/// Closed, code-coupled set (docs/architecture/database/conventions-and-enums.md §1) — one value
/// per distinct backup artifact this checkpoint generates. Payslip PDFs and an Audit Log export
/// were both evaluated in the architecture review and explicitly deferred (absent from the frozen
/// docs/architecture/workflows/payroll-lifecycle.md §5 spec, and — for Payslips — redundantly
/// regenerable on demand from released `PayrollEntry` data, per
/// docs/architecture/system-conventions.md §2's existing reasoning for not caching them). Extending
/// this enum additively is exactly how either would be added later (Principle 8), not by
/// repurposing an existing value.
enum BackupFileType {
  MANIFEST
  PAYROLL_ENTRY_CSV
  PAYROLL_ENTRY_XLSX
  BANK_SHEETS_CSV
  CASH_RECEIVING_CSV
}

/// The disaster-recovery/external-access artifact for one payroll cycle
/// (docs/architecture/workflows/payroll-lifecycle.md §5). **Amended from the originally frozen
/// sketch (docs/architecture/database/payroll-cycle.md §17) by the 2026-07-14 architecture
/// review** — `status`, `generatedBy`, and `failureReason` are additions the original sketch
/// omitted, needed respectively for: representing an in-flight/failed generation attempt without a
/// queue (`status`), actor attribution matching every other lifecycle table's own convention
/// (`generatedBy` — `createdBy`/`releasedBy` on `PayrollCycle` itself), and a non-sensitive
/// diagnostic string for a failed attempt (`failureReason`). This checkpoint only ever creates rows
/// via manual, explicit generation — the automatic generation this table is ultimately meant to
/// serve (triggered by the cycle archive transition) is later, separately-authorized Phase 5 work.
model BackupPackage {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cycleId               String              @db.Uuid
  /// Reserved atomically (`MAX(version) + 1` inside the same transaction that inserts this row) —
  /// never client-supplied. A concurrent second reservation attempt for the same `cycleId` loses
  /// the race against the `(cycleId, version)` unique constraint below and is translated to a
  /// clean, typed conflict — see the service's own doc comment.
  version               Int                 @default(1)
  status                BackupPackageStatus @default(GENERATING)
  /// Set only on the `GENERATING -> READY` transition, in the same transaction as every
  /// `BackupPackageFile` row — never set independently of that transition.
  generatedAt           DateTime?           @db.Timestamptz(6)
  generatedBy           String              @db.Uuid
  /// The deployed app release identifier at generation time (`backend/package.json`'s own
  /// `version` field today — this project does not yet bump it per deploy, a known, accepted
  /// limitation rather than something this checkpoint invents a fix for).
  applicationVersion    String              @db.VarChar(40)
  /// The latest applied Prisma migration name at generation time, read directly from Prisma's own
  /// `_prisma_migrations` table — no new schema needed to track this.
  databaseSchemaVersion String              @db.VarChar(60)
  /// Released/held/pending entry counts at generation time — computed identically to Finalize
  /// Cycle's own `payroll_cycle.released` audit metadata shape (`entryCount`/`releasedCount`/
  /// `heldCount`), not a new calculation.
  releaseStatusSummary  Json
  /// Nullable until the package reaches `READY` (unknown while `GENERATING`, meaningless if
  /// `FAILED`).
  totalSizeBytes        BigInt?
  fileCount             Int?
  /// SHA-256 hex of the manifest's own canonical JSON — changes if any file's size/checksum or any
  /// other manifest field changes. Nullable until `READY`.
  manifestChecksum      String?             @db.VarChar(64)
  /// Set only when `status = FAILED` — a short, non-sensitive diagnostic (exception message class,
  /// never a stack trace, SQL detail, or filesystem path).
  failureReason         String?
  createdAt             DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime            @updatedAt @db.Timestamptz(6)

  cycle           PayrollCycle        @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  generatedByUser User                @relation("BackupPackageGeneratedBy", fields: [generatedBy], references: [id], onDelete: Restrict)
  files           BackupPackageFile[]
  /// The reverse side of `PayrollCycle.archivedWithBackupPackage` (Phase 5 Checkpoint 3) — normally
  /// at most one element, since only one cycle is ever archived with a given package as its
  /// gating version, but Prisma models the FK direction as a list regardless.
  archivedCycles  PayrollCycle[]      @relation("PayrollCycleArchivedWithBackupPackage")

  @@unique([cycleId, version])
  @@index([cycleId])
  @@index([status])
}

/// One physical stored file within a `BackupPackage`
/// (docs/architecture/database/payroll-cycle.md §18). **Amended from the originally frozen sketch**
/// — `filename`, `contentType`, `checksum`, and `sortOrder` are additions the original sketch
/// omitted, needed respectively for: a safe, sanitized download filename distinct from the
/// (untrusted) `storageKey`, a `Content-Type` response header (`StorageProvider` itself never
/// retains this after `write()`, see `docs/architecture/system-conventions.md §2`), per-file
/// integrity verification, and deterministic listing/manifest order. Immutable, append-only, no
/// update path — a regenerated package is always a new `BackupPackage` version with its own new
/// `BackupPackageFile` rows, never an edit to an existing one's rows.
model BackupPackageFile {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  backupPackageId String         @db.Uuid
  fileType        BackupFileType
  filename        String
  /// Key/path resolved via the `StorageProvider` abstraction — never exposed to API clients
  /// directly; every download is authorized and resolved through this row's own `id`.
  storageKey      String
  contentType     String
  sizeBytes       BigInt
  /// SHA-256 hex, computed from the exact bytes written to storage.
  checksum        String         @db.VarChar(64)
  /// Deterministic listing/manifest order — `manifest.json` first, then the data files in the
  /// fixed order the service always generates them in.
  sortOrder       Int
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)

  backupPackage BackupPackage @relation(fields: [backupPackageId], references: [id], onDelete: Restrict)

  @@unique([backupPackageId, fileType])
  @@index([backupPackageId])
}
