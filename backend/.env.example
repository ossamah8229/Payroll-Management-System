# Copy to .env and fill in real values for local development.
# Never commit a real .env file — it's already covered by the root .gitignore.

NODE_ENV=development
PORT=4000

# Local Postgres started via `docker compose up -d` from the repo root
DATABASE_URL="postgresql://payroll:payroll_dev_password@localhost:5432/payroll_dev?schema=public"

# Used to sign the express-session cookie. Generate a real random value for anything beyond
# local dev, e.g.: `openssl rand -base64 48`
SESSION_SECRET="dev-only-session-secret-change-me"

# Used by the csrf-csrf double-submit cookie middleware (docs/architecture/authentication.md).
CSRF_SECRET="dev-only-csrf-secret-change-me"

# The frontend origin allowed to make credentialed cross-origin requests in development.
CORS_ORIGIN="http://localhost:5173"

# Root directory for the LocalFilesystemStorageProvider (docs/architecture/system-conventions.md
# §2) — resolved relative to the backend process's working directory when not already absolute.
# Gitignored (see .gitignore's "Local storage" entry); created automatically if missing.
STORAGE_ROOT="storage"
