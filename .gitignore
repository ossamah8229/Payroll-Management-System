# OS
.DS_Store

# Dependencies
node_modules/

# Environment
.env
.env.local
.env.*.local

# Build output
dist/
build/
dist-types-*/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*

# Editor
.vscode/
.idea/
.claude/

# Local storage (StorageProvider local filesystem implementation)
backend/storage/

# Puppeteer's downloaded Chrome/chrome-headless-shell binaries, installed here (instead of the
# default ~/.cache/puppeteer) by `npx puppeteer browsers install chrome` per backend/.puppeteerrc.cjs
# — see that file's comment. Never committed — every environment (local dev, CI, each Render
# build) downloads its own binary.
backend/.cache/
# Test-only storage root (backend/tests/env.setup.ts's STORAGE_ROOT fallback) — created the moment
# any test file imports src/app.ts, since Phase 5 Checkpoint 2 wires the StorageProvider singleton
# up as a real dependency of backup-packages.routes.ts. backup-packages.test.ts removes its own
# generated content in its own afterAll; this covers the directory itself as defense in depth.
backend/storage-test-unused/

# Playwright E2E harness (AUD-013, Post-Phase-5 Stabilization Checkpoint 4) —
# tests/e2e/setup/e2e-environment.ts's own ephemeral database/storage/logs/PID-state directory,
# never committed and always removed by its own teardown; the two generated report/artifact
# directories `playwright test` itself produces.
tests/e2e/.tmp/
playwright-report/
test-results/
blob-report/
playwright/.cache/
